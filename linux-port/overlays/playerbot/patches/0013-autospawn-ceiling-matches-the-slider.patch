diff --git a/game/src/input_db.cpp b/game/src/input_db.cpp
--- a/game/src/input_db.cpp
+++ b/game/src/input_db.cpp
@@ -1383,0 +1384,13 @@
+		// The ceiling has to be the number the launcher's slider offers, and
+		// for a long time it was not: Set-PlayerbotCount clamps at 2500 and
+		// this cut it to 1000, so an operator who asked for more got exactly
+		// a thousand bots with nothing anywhere saying why - reported from the
+		// Discord as "raised the slider and nothing happened".
+		//
+		// 2500 is the seed's canonical cohort (1500 Chunjo + 500 Shinsoo +
+		// 500 Jinno), so no larger number can name identities that exist. The
+		// real guard is below and always was: SplitPopulation caps each
+		// kingdom at the identities it actually has, and SpawnRegistered at
+		// what LoadRegisteredBots accepted. This clamp only stops a typo in
+		// .env from asking for a million, and it says so when it fires.
+		const int autoSpawnCeiling = 2500;
@@ -1386,2 +1399,6 @@
-		else if (autoSpawnCount > 1000)
-			autoSpawnCount = 1000;
+		else if (autoSpawnCount > autoSpawnCeiling)
+		{
+			sys_log(0, "PLAYERBOT: autospawn asked=%d, cut to the ceiling %d",
+					autoSpawnCount, autoSpawnCeiling);
+			autoSpawnCount = autoSpawnCeiling;
+		}
