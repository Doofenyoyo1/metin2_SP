+	return m_aiEmpireUserCount[1] + m_aiEmpireUserCount[2] + m_aiEmpireUserCount[3]
+		- CountPlayerBots(0);
@@ -263 +288 @@
-	return m_aiEmpireUserCount[idx];
+	return m_aiEmpireUserCount[idx] - CountPlayerBots(idx);
