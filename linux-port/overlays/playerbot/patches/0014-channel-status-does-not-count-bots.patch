diff --git a/game/src/p2p.cpp b/game/src/p2p.cpp
--- a/game/src/p2p.cpp
+++ b/game/src/p2p.cpp
@@ -6,0 +7 @@
+#include "playerbot_manager.h"
@@ -253,0 +255,23 @@
+// The playerbots on the other cores are subtracted here rather than kept
+// out of the incremental counters above: a login can arrive before this
+// core has loaded the bot registry, and a counter that skipped the login
+// but not the logout would drift below zero for the life of the process.
+// Asking the registry at read time is always answered from its current
+// state, and this is read once per player login and every five minutes.
+int P2P_MANAGER::CountPlayerBots(int empire) const
+{
+	int n = 0;
+	for (TPIDCCIMap::const_iterator it = m_map_dwPID_pkCCI.begin();
+			it != m_map_dwPID_pkCCI.end(); ++it)
+	{
+		const CCI* pkCCI = it->second;
+		if (pkCCI->bChannel != g_bChannel)
+			continue;
+		if (empire != 0 && pkCCI->bEmpire != empire)
+			continue;
+		if (CPlayerBotManager::instance().IsRegisteredBotPID(pkCCI->dwPID))
+			++n;
+	}
+	return n;
+}
+
