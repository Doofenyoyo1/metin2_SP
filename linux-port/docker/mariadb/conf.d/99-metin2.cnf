# =============================================================================
#  MariaDB settings the r40250 server requires.
#
#  Neither line is a preference.  Both are load-bearing.
# =============================================================================
[mysqld]

# r40250 writes values that modern strict mode rejects outright: zero dates
# ('0000-00-00'), out-of-range integers, and '' into enum columns.  With
# MariaDB's default STRICT_TRANS_TABLES those writes become errors, and the db
# core -- which is compiled without -DNDEBUG, so its assert()s are live --
# aborts rather than warns.  The my.cnf shipped inside metin2_mysql_dump.zip
# asks for exactly this value.
sql_mode = NO_ENGINE_SUBSTITUTION

# The dumps and every string the server sends are latin1.  On a utf8mb4 server
# the import "succeeds" and every non-ASCII character in an item or mob name is
# silently mangled -- which then shows up as garbled text in the client, long
# after the point where anyone would connect it to a charset setting.
character-set-server = latin1
collation-server     = latin1_swedish_ci

# The game cores hold several long-lived connections each and the panel adds a
# handful; the default 151 is enough, but a 4-channel server plus a busy panel
# is close enough to it to be worth raising.
max_connections = 200

# Seventy-three of the seventy-five game tables are MyISAM, which does not
# survive an unclean stop: a pulled plug, a killed container or a full disk
# leaves one marked as crashed, and everything that reads it fails from then on
# ("Table './player/quest' is marked as crashed and last (automatic?) repair
# failed" - the panel showing it, reported from the Discord). MariaDB's default
# here is BACKUP,QUICK, and QUICK only rebuilds the index file: when the data
# file is the damaged one the automatic repair gives up, which is exactly what
# that message says happened. FORCE runs the full repair even when it would
# cost a row, and BACKUP keeps the damaged .MYD next to it first, so nothing is
# thrown away silently. A repaired table beats a server nobody can log into.
myisam_recover_options = BACKUP,FORCE

# 128 sequential 'Data truncated' warnings on player.mob_proto.size and
# player.skill_proto.setAffectFlag{,2} during the first-run import are EXPECTED
# and harmless: the dump itself stores '' in those enum columns, so a faithful
# import must reproduce it.

# Durability per statement is what a bank needs, and what hung the login on a
# world of 2482 bots: the game's tables are InnoDB here, and with the default
# flush-on-every-commit each of their ~100 writes a second waited for an fsync
# on Docker Desktop's disk (~70 a second on the test machine). The db core's
# player queue held ~1900 queries, and a player's login - one SELECT at the
# back of that queue - was answered 14-28 seconds later, after the client had
# given up ("wisi na ekranie logowania", sizowski, 2.0.11). Flushing the log
# once a second instead loses at most a second of saves if the machine loses
# power, and lets the queue drain as fast as the disk can write.
innodb_flush_log_at_trx_commit = 2
