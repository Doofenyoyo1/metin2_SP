# =============================================================================
#  MariaDB settings the mt2009 server files require.
# =============================================================================
[mysqld]

# The schema carries '0000-00-00 00:00:00' defaults and the cores write values
# strict mode rejects; the db core is built with live assert()s and aborts on
# a refused write rather than warning.
sql_mode = NO_ENGINE_SUBSTITUTION

# The game connects with SET NAMES cp1250 (locale poland) and every dumped
# table names its own charset; this is only the default for what gets created
# afterwards.
character-set-server = cp1250
collation-server     = cp1250_general_ci

max_connections = 200

# The twelve log tables are MyISAM and do not survive an unclean stop; FORCE
# runs the full repair, BACKUP keeps the damaged file beside it.
myisam_recover_options = BACKUP,FORCE

# Durability per statement is what a bank needs, and what hung the login on a
# world of 2482 bots: the game's tables are InnoDB here, and with the default
# flush-on-every-commit each of their ~100 writes a second waited for an fsync
# on Docker Desktop's disk (~70 a second on the test machine). The db core's
# player queue held ~1900 queries, and a player's login - one SELECT at the
# back of that queue - was answered 14-28 seconds later, after the client had
# given up ("wisi na ekranie logowania", sizowski, 2.0.11). Flushing the log
# once a second instead loses at most a second of saves if the machine loses
# power, and lets the queue drain as fast as the disk can write.
innodb_flush_log_at_trx_commit = 2
