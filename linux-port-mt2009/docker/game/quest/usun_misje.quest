		-- END GENERATED

		-- a gameforge. / translate. path to its text
		function resolve(path)
			if path == nil or path == "" then
				return nil
			end
			local cur = _G
			for part in string.gfind(path, "[^%.]+") do
				if type(cur) ~= "table" then
					return nil
				end
				cur = cur[part]
			end
			if type(cur) == "string" and cur ~= "" then
				return cur
			end
			return nil
		end

		-- the name of a quest's state now (nil: no such quest loaded)
		function state_of(name)
			local t = _G[name]
			if type(t) ~= "table" then
				return nil
			end
			local st = pc.getf(name, "__status")
			if st == 0 then
				return "start"
			end
			for k, v in pairs(t) do
				if type(k) == "string" and type(v) == "number" and v == st then
					return k
				end
			end
			return nil
		end

		function has_state(name, sname)
			local t = _G[name]
			return type(t) == "table" and type(t[sname]) == "number"
		end

		-- the state, when the mission is open (shows a letter) now
		function open_state(m)
			local st = usun_misje.state_of(m[1])
			if st ~= nil and m[5][st] ~= nil and usun_misje.has_state(m[1], m[4]) then
				return st
			end
			return nil
		end

		function category_name(cat)
			if cat == 1 then
				return "Fabu³a"
			elseif cat == 2 then
				return "Misja poboczna"
			elseif cat == 3 then
				return "Biolog"
			end
			return "Zio³a Baek-Go"
		end

		function title(m, st)
			local t = usun_misje.resolve(m[5][st])
			if t == nil then
				t = usun_misje.category_name(m[2])
				if m[3] > 0 then
					t = t .. " (poz. " .. m[3] .. ")"
				end
			end
			t = string.gsub(t, "[%c]", "")
			t = string.gsub(t, "^%s+", "")
			t = string.gsub(t, "%s+$", "")
			t = string.gsub(t, "%s+", "_")
			if string.len(t) > 48 then
				t = string.sub(t, 1, 48)
			end
			return t
		end

		function send_list(mode)
			cmdchat("MISJE begin " .. mode)
			local list = usun_misje.data()
			for i = 1, table.getn(list) do
				local m = list[i]
				local st = usun_misje.open_state(m)
				if st ~= nil then
					cmdchat(string.format("MISJE m %d %d %d %s", i, m[2], m[3], usun_misje.title(m, st)))
				end
			end
			cmdchat("MISJE end")
		end

		-- the checked ones of one window (a few chat lines of ids)
		function remove(args)
			local list = usun_misje.data()
			local byname = {}
			for i = 1, table.getn(list) do
				byname[list[i][1]] = list[i]
			end
			-- every quest gets one new state per run: the engine keeps the
			-- changes until the run ends and checks each one's old state
			local target = {}
			local done = {}
			for k = 2, table.getn(args) do
				local id = tonumber(args[k])
				local m = nil
				if id ~= nil then
					m = list[id]
				end
				if m ~= nil and target[m[1]] == nil and usun_misje.open_state(m) ~= nil then
					target[m[1]] = m[4]
					table.insert(done, m)
				end
			end
			-- the next part of a chain, as the finish would have started it
			local started = {}
			for k = 1, table.getn(done) do
				local chain = done[k][6]
				for c = 1, table.getn(chain) do
					local q = chain[c][1]
					local s = chain[c][2]
					if target[q] == nil and usun_misje.has_state(q, s) and pc.getf(q, "__status") == 0 then
						target[q] = s
						table.insert(started, q)
					end
				end
			end
			for q, s in pairs(target) do
				set_quest_state(q, s)
			end
			-- the letter, its button and its arrows go now
			for k = 1, table.getn(done) do
				local idx = pc.clear_quest_letter(done[k][1])
				if idx ~= nil and idx > 0 then
					cmdchat("MISJE gone " .. idx)
				end
			end
			-- the quest's own items, unless a listed quest still open uses them
			local users = usun_misje.item_users()
			for k = 1, table.getn(done) do
				local own = done[k][7]
				for j = 1, table.getn(own) do
					local vnum = own[j]
					local keep = false
					local who = users[vnum] or {}
					for u = 1, table.getn(who) do
						local other = byname[who[u]]
						if target[who[u]] == nil and other ~= nil and usun_misje.open_state(other) ~= nil then
							keep = true
						end
					end
					local n = pc.count_item(vnum)
					if not keep and n > 0 then
						pc.remove_item(vnum, n)
					end
				end
			end
			for k = 1, table.getn(done) do
				sys_log(0, string.format("USUN_MISJE: %s %s -> %s", pc.get_name(), done[k][1], done[k][4]))
			end
			for k = 1, table.getn(started) do
				sys_log(0, string.format("USUN_MISJE: %s next part %s -> %s", pc.get_name(), started[k], target[started[k]]))
			end
			pc.setqf("n", pc.getqf("n") + table.getn(done))
		end

		function finish()
			local n = pc.getqf("n")
			pc.setqf("n", 0)
			if n <= 0 then
				syschat("Nie usuniêto ¿adnej misji.")
				return
			end
			syschat(string.format("Usuniêto misje: %d (bez nagród).", n))
			-- what opened since (the next part of a chain) in the window
			usun_misje.send_list(1)
		end

		when write with mes.get_message() == "usunmisje" begin
			if pc.is_playerbot() then
				return
			end
			if game.get_event_flag("mt2009_usunmisje_off") ~= 0 then
				syschat("Usuwanie misji jest teraz wy³¹czone.")
				return
			end
			local args = mes.get_arguments()
			local cmd = args[1] or ""
			if cmd == "usun" then
				usun_misje.remove(args)
			elseif cmd == "gotowe" then
				usun_misje.finish()
			else
				usun_misje.send_list(0)
			end
		end
	end
end
