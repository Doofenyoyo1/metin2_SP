-- MT2009_PLUS_GUILD_TREASURY_V1 (owner, 4 October): the package's
-- guild_building with the land paid from the guild's treasury first - the
-- yang the members and the bots' collections ("Zrzutka yang") paid in, which
-- nobody can take out into a bag any more (server-patches/enginefixes,
-- CGuild::SpendGuildMoney) - and only the rest from the master's own yang.
quest guild_building begin
    state start begin
	when 20040.click begin
	    say_title(gameforge.guild_building._10_sayTitle)
		say(gameforge.guild_building._20_say)

	    local s =  select(locale.yes, locale.no)

	    if s == 1 then
		if not pc.is_guild_master() then
		    say_title(gameforge.guild_building._10_sayTitle)
			say(gameforge.guild_building._30_say)
		elseif building.has_land(pc.get_guild()) then
		    say_title(gameforge.guild_building._10_sayTitle)
			say(gameforge.guild_building._40_say)
		else

			if pc.get_empire() != npc.get_empire() then
				npc_name()
				say_split(translate.guild_land.wrong_empire)
				return
			end

		    local land_id = building.get_land_id(pc.get_map_index(), pc.get_x()*100, pc.get_y()*100)

		    if land_id == 0 then
			say_title(gameforge.guild_building._10_sayTitle)
			say(gameforge.guild_building._50_say)
		    else
			local price, owner, guild_level_limit = building.get_land_info(land_id)
			say_title(gameforge.guild_building._10_sayTitle)
			say(string.format(gameforge.guild_building._60_say, guild_level_limit, price))
			local skarbiec = guild.treasury_available()
			if skarbiec > 0 then
			    say(string.format("Ze skarbca gildii (%d Yang) zap³acisz %d Yang, resztê z w³asnego ekwipunku.", skarbiec, math.min(skarbiec, price)))
			end

			if guild.level(pc.get_guild()) < guild_level_limit then
			    say_title(gameforge.guild_building._10_sayTitle)
				say(gameforge.guild_building._70_say)
			else
			    say_title(gameforge.guild_building._10_sayTitle)
				say(gameforge.guild_building._80_say)

			    s =  select(locale.yes, locale.no)

			    if s == 1 then
				local price, owner, guild_level_limit = building.get_land_info(land_id)

				if owner!= 0 then
				    say_title(gameforge.guild_building._10_sayTitle)
					say(gameforge.guild_building._90_say)
				elseif pc.gold < price - math.min(guild.treasury_available(), price) then
				    say_title(gameforge.guild_building._10_sayTitle)
					say(gameforge.guild_building._100_say)
				else
				    local z_skarbca = math.min(guild.treasury_available(), price)
				    if z_skarbca > 0 and not guild.treasury_spend(z_skarbca, "land") then
					z_skarbca = 0
				    end
				    if pc.gold < price - z_skarbca then
					say_title(gameforge.guild_building._10_sayTitle)
					say(gameforge.guild_building._100_say)
					return
				    end
				    if price - z_skarbca > 0 then
					pc.changegold(-(price - z_skarbca))
				    end
				    building.set_land_owner(land_id, pc.get_guild())
				    notice_multiline(string.format(gameforge.guild_building._105_say, guild.name(pc.get_guild())),notice)
				    if z_skarbca > 0 then
					chat(string.format("[Gildia] Ze skarbca gildii zap³acono %d Yang, z Twojego ekwipunku %d Yang.", z_skarbca, price - z_skarbca))
				    end
				end
			    else
				say_title(gameforge.guild_building._10_sayTitle)
				say(gameforge.guild_building._110_say)
			    end
			end
		    end
		end
	    else
            say_title(gameforge.guild_building._10_sayTitle)
		    say(gameforge.guild_building._110_say)
	    end
	end
    end
end


