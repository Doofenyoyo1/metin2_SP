-- "Auto Lowy (8h)" (31073, sold in the ItemShop): eight hours of the client's
-- auto hunt, counted only while the character is in the game. The time is
-- affect 560 - ProcessAffect counts an affect down once a second only while its
-- character is loaded, Disconnect saves what is left, and a death keeps the
-- types 500-599 - which the engine asks for before it answers /autohunt_target
-- and /autohunt_loot when the world wants the ticket (the event flag
-- m2_autohunt_item: .env M2_AUTOHUNT_ITEM, the launcher's difficulty window,
-- the classic panel; playerbotify apply_auto_hunt_item_switch). A world where
-- everybody may hunt keeps the ticket. The ticket was the package's unused
-- "Opaska Posz. Zlota" (migratorify.py renames it). Bots never come here.
quest autohunt_time begin
    state start begin
        when 31073.use begin
            if game.get_event_flag("m2_autohunt_off") > 0 then
                syschat("Auto Lowy sa na tym swiecie wylaczone - zachowaj bilet.")
                return
            end
            if game.get_event_flag("m2_autohunt_item") == 0 then
                syschat("Auto Lowy sa teraz dostepne dla kazdego - zachowaj bilet na pozniej.")
                return
            end
            local left = affect.get_duration(560)
            if left < 0 then
                left = 0
            end
            if left > 30 * 86400 then
                syschat("Auto Lowy: masz juz ponad 30 dni czasu.")
                return
            end
            pc.remove_item(31073, 1)
            left = left + 8 * 3600
            affect.add_new(560, 0, 0, left, 0, true)
            syschat(string.format("Auto Lowy: +8 h, razem %d h (liczy sie tylko czas w grze).", math.floor(left / 3600)))
        end
    end
end
