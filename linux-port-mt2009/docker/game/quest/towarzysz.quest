-- Towarzysz: the player's own companion (playerbot_sidekick.h,
-- 24 September). A letter at every login is the whole interface: before the
-- companion exists it asks for the class, the sex, the path and the name, and
-- afterwards it is the companion's menu - call it back, let it play on its
-- own, say how it fights, ask how it is, send it away.
--
-- The work is the server's /towarzysz command (cmd_general.cpp through
-- playerbotify.py): it picks one of the kingdom's seeded bot identities of the
-- race asked for, renames it, writes player.playerbot_sidekick and sets this
-- quest's flag "created" before the command returns, so the flag is the answer
-- to whether it worked. The command also answers in the chat, with the reason
-- when it refused (a name taken or not allowed, no free character of that
-- class). A bot that logs in reads the letter too; a bot's client does not
-- exist, and the command refuses a bot anyway.
--
-- The world may do without it: M2_SIDEKICK=0 in .env (the launcher's
-- difficulty window) is the event flag m2_sidekick_off, and then no letter is
-- sent, so nobody has the way in (25 September). A letter already in
-- the bag from before says so, and the server refuses the command anyway.
--
-- Every text is Polish or English as the player's client asked
-- (playerbot_lang.quest; towarzysz.t). The orders sent to the server stay the
-- Polish words the command takes.
quest towarzysz begin
	state start begin
		-- The player's language: the flag its client's answer left on the
		-- character (playerbot_language.h). A client that never answered
		-- reads Polish.
		function t(pl, en)
			if pc.getf("playerbot_lang", "en") == 1 then
				return en
			end
			return pl
		end

		when login begin
			if game.get_event_flag("m2_sidekick_off") == 0 then
				send_letter(towarzysz.t("Towarzysz", "Companion"))
				-- The title above is in the language of the character's last
				-- session: this login's own answer to playerbot_lang's question
				-- comes a moment after the login quests, so a character's first
				-- session in English had "Towarzysz" on its letter. Looked at
				-- again once the answer is in, and sent again when the language
				-- turned out to be the other one: the client puts a quest's
				-- letter in the place of the one it had (BINARY_RecvQuest). A
				-- bot has no client to answer, so it is not asked.
				if not pc.is_playerbot() then
					pc.setqf("letter_en", pc.getf("playerbot_lang", "en"))
					timer("towarzysz_letter_lang", 5)
				end
			end
		end

		when towarzysz_letter_lang.timer begin
			local en = pc.getf("playerbot_lang", "en")
			if game.get_event_flag("m2_sidekick_off") == 0 and pc.getqf("letter_en") != en then
				pc.setqf("letter_en", en)
				send_letter(towarzysz.t("Towarzysz", "Companion"))
			end
		end

		when button or info begin
			local title = towarzysz.t("Towarzysz", "Companion")
			if game.get_event_flag("m2_sidekick_off") != 0 then
				say_title(title)
				say(towarzysz.t("Towarzysze sa wylaczeni na tym serwerze.", "Companions are switched off on this server."))
				say(towarzysz.t("Wlacza je wlasciciel serwera w launcherze", "The server owner turns them on in the launcher"))
				say(towarzysz.t("(poziom trudnosci swiata).", "(the world's difficulty)."))
				return
			end
			if pc.getqf("created") == 0 then
				say_title(title)
				say(towarzysz.t("Mozesz zabrac w droge stalego towarzysza: postac,", "You can take a companion along for good: a"))
				say(towarzysz.t("ktora jest z toba w grupie, expi z toba po rowno,", "character in your party that levels with you,"))
				say(towarzysz.t("biega za toba, broni cie i zbiera twoj drop.", "follows you, guards you and picks up your drop."))
				say("")
				say(towarzysz.t("Jaka ma byc jego klasa?", "What class should it be?"))
				local c = select(towarzysz.t("Wojownik", "Warrior"), "Ninja", "Sura", towarzysz.t("Szaman", "Shaman"),
					towarzysz.t("Pozniej", "Later"))
				if c == 5 then
					return
				end
				say_title(title)
				say(towarzysz.t("Kobieta czy mezczyzna?", "A woman or a man?"))
				local s = select(towarzysz.t("Mezczyzna", "Man"), towarzysz.t("Kobieta", "Woman"))
				-- player.job: 0 warrior, 1 ninja, 2 sura, 3 shaman for the one sex
				-- the class was first made in, and the same plus four for the other.
				local male = { 0, 5, 2, 7 }
				local female = { 4, 1, 6, 3 }
				local race = male[c]
				if s == 2 then
					race = female[c]
				end
				say_title(title)
				say(towarzysz.t("Jaka sciezka?", "Which path?"))
				local g = 1
				if c == 1 then
					g = select(towarzysz.t("Cialo (Body)", "Body"), towarzysz.t("Umysl (Mental)", "Mental"))
				elseif c == 2 then
					g = select(towarzysz.t("Skrytobojca (sztylety)", "Assassin (daggers)"), towarzysz.t("Lucznik (luk)", "Archer (bow)"))
				elseif c == 3 then
					g = select(towarzysz.t("Ostrze (Weaponry)", "Weaponry"), towarzysz.t("Czarna Magia", "Black Magic"))
				else
					g = select(towarzysz.t("Smok (Dragon)", "Dragon"), towarzysz.t("Uzdrowienie (Heal)", "Healing"))
				end
				say_title(title)
				say(towarzysz.t("Jak ma sie nazywac?", "What should it be called?"))
				say(towarzysz.t("Od 3 do 16 liter i cyfr, bez spacji.", "3 to 16 letters and digits, no spaces."))
				local name = input()
				if name == nil or name == "" then
					return
				end
				command("towarzysz stworz " .. race .. " " .. g .. " " .. name)
				if pc.getqf("created") == 1 then
					say_title(title)
					say(name .. towarzysz.t(" juz idzie do ciebie.", " is on its way to you."))
					say("")
					say(towarzysz.t("Ten list zostaje: to menu twojego towarzysza.", "This letter stays: it is your companion's menu."))
					say(towarzysz.t("Okno towarzysza otwiera klawisz P. Mozesz tez mu", "The P key opens its window. You can also whisper"))
					say(towarzysz.t("szepnac: chodz, graj sam, czekaj, zakupy, stan.", "to it: come, go play, wait, shopping, status."))
				end
				return
			end

			say_title(title)
			say(towarzysz.t("Co mam zrobic?", "What shall I do?"))
			say("")
			say(towarzysz.t("Szeptem tez zrozumiem: chodz, graj sam, czekaj,", "I understand whispers too: come, go play, wait,"))
			say(towarzysz.t("zakupy, stan, atakuj, nie atakuj pierwszy, nie walcz.", "shopping, status."))
			local m = select(towarzysz.t("Okno towarzysza (klawisz P)", "Companion window (P key)"),
				towarzysz.t("Przywolaj do mnie", "Come to me"),
				towarzysz.t("Graj po swojemu (wolna reka)", "Play on your own (free hand)"),
				towarzysz.t("Jak ma walczyc?", "How should it fight?"), towarzysz.t("Jak sie masz?", "How are you?"),
				towarzysz.t("Odejdz na dobre", "Leave for good"), towarzysz.t("Nic", "Nothing"))
			if m == 1 then
				-- The window (uisidekick.py, client 2.0.33); an older client
				-- only writes an unknown command to its syserr.txt.
				cmdchat("SidekickWindow")
				return
			end
			m = m - 1
			if m == 1 then
				command("towarzysz przywolaj")
			elseif m == 2 then
				command("towarzysz wolny")
			elseif m == 3 then
				say_title(title)
				say(towarzysz.t("Jak mam walczyc przy tobie?", "How shall I fight at your side?"))
				local w = select(towarzysz.t("Atakuje wszystko w poblizu", "I attack everything nearby"),
					towarzysz.t("Nie atakuje pierwszy", "I never attack first"),
					towarzysz.t("Nie walcze, tylko sie bronie", "I don't fight, I only defend"),
					towarzysz.t("Bez zmian", "No change"))
				if w <= 3 then
					command("towarzysz walka " .. (w - 1))
				end
			elseif m == 4 then
				command("towarzysz stan")
			elseif m == 5 then
				say_title(title)
				say(towarzysz.t("Na pewno? Towarzysz odejdzie, a jego postac", "Sure? Your companion leaves, and its character"))
				say(towarzysz.t("wroci do swiata jako zwykly bot. Nowego", "goes back to the world as an ordinary bot. You"))
				say(towarzysz.t("mozesz wybrac od razu.", "can choose a new one right away."))
				if select(towarzysz.t("Tak, odejdz", "Yes, leave"), towarzysz.t("Nie", "No")) == 1 then
					command("towarzysz odprawa tak")
				end
			end
		end
	end
end
