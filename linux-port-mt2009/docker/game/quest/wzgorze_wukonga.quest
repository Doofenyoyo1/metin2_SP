-- MT2009_PLUS_AREZZO_V1 (wukong): Wzgórze Wukonga - loch od poziomu 45 (mapa 364, plechito_wukong_dungeon z Arezzo),
-- tylko dla graczy. Wzorzec biblioteka_wiedzy.quest (tools/questgen.py): Stra¿nik Wzgórza (20423) w Œwi¹tyni Hwang
-- otwiera instancjê na game2 jednym ³adowaniem. Etapy: 3 fale po 60 ma³p (Pieczêæ Wzgórza 30766), 6 Kamieni Wzgórza,
-- 3 Obroñców Chmur, 4 Jaja Feniksa, P³omienny Feniks, WuKong; potem 1-3 Skrzynie Wukonga (30774) dla ka¿dego gracza.
-- Limit 30 minut, ponowne wejœcie po 30 minutach.
quest wzgorze_wukonga begin
	state start begin
		function cfg()
			return {
				map = 364,
				base_x = 8448, base_y = 5376, size = 512,
				entry = {264, 273},
				exit_map = 65, exit_x = 5537, exit_y = 1450,
				min_level = 45,
				near = 30,
				cooldown = 30 * 60,
				limit_min = 30,
				-- MT2009_PLUS_DUNGEON_FEE_V1: the price of a new expedition (each player, paid on entering it) and
				-- how many new expeditions a player may start a day (Polish midnight).
				fee = 5000000, fee_text = "5 000 000",
				daily = 5,
				wave_kills = 60,
				seals = 3,
				chests_min = 1, chests_max = 3,
				path = "data/dungeon/wzgorze_wukonga/",
				-- MT2009_PLUS_WUKONG_GUARDIANS_V1: the Cloud Defenders' places (guardians.txt before), all
				-- at least 8 cells inside the arena's edge, and how long stage 3 may go without a
				-- Defender falling before one at full health is put back on its place.
				guardians = {{277, 289}, {253, 260}, {251, 286}},
				guardian_idle = 180,
			}
		end

		-- MT2009_PLUS_DUNGEON_FEE_V1: the entry fee and the daily limit. Checked for everyone at the guard (with
		-- the level and the rest), paid on the first login into a new instance (every way in:
		-- the guard, the lobby, the lobby's own timer) - no money or no runs left there sends
		-- the player out. "Wróæ do lochu" into the same instance costs nothing. GMs are free.
		function today()
			return math.floor((get_global_time() + 7200) / 86400)
		end

		function runs_today()
			if pc.getf("wzgorze_wukonga", "day") ~= wzgorze_wukonga.today() then
				return 0
			end
			return pc.getf("wzgorze_wukonga", "runs")
		end

		function over_limit()
			local c = wzgorze_wukonga.cfg()
			return not pc.is_gm() and wzgorze_wukonga.runs_today() >= c.daily
		end

		function too_poor()
			local c = wzgorze_wukonga.cfg()
			return not pc.is_gm() and pc.get_money() < c.fee
		end

		function pay_entry()
			local c = wzgorze_wukonga.cfg()
			if pc.is_gm() or pc.is_playerbot() then
				return true
			end
			if wzgorze_wukonga.over_limit() then
				syschat("Wykorzysta³eœ ju¿ dzisiejsze wyprawy do tego lochu ("..c.daily.."). Wróæ jutro.")
				return false
			end
			if pc.get_money() < c.fee then
				syschat("Wejœcie kosztuje "..c.fee_text.." Yang - nie masz tyle przy sobie.")
				return false
			end
			pc.change_money(-c.fee)
			local day = wzgorze_wukonga.today()
			if pc.getf("wzgorze_wukonga", "day") ~= day then
				pc.setf("wzgorze_wukonga", "day", day)
				pc.setf("wzgorze_wukonga", "runs", 0)
			end
			pc.setf("wzgorze_wukonga", "runs", pc.getf("wzgorze_wukonga", "runs") + 1)
			syschat("Op³ata za wejœcie: "..c.fee_text.." Yang. Dzisiejsza wyprawa "..pc.getf("wzgorze_wukonga", "runs").."/"..c.daily..".")
			return true
		end

		function inside()
			local idx = pc.get_map_index()
			return idx >= 364 * 10000 and idx < 365 * 10000
		end

		-- MT2009_PLUS_DUNGEON_END_V1 (2 October): the end of a run, seen from every core. A player used a
		-- Teleport Ring in the minute after the boss, and his guard (another core: d.find cannot tell what
		-- game2 holds) kept offering "Wróæ do lochu" into an instance that was gone. The boss's kill (or the
		-- time limit) now writes the end time to an event flag of the instance's slot (map and the last two
		-- digits of its index - a slot comes round again only after 100 more instances of the map), and
		-- every core compares it with the player's own entry time: a run that ended after he went in is over.
		function end_flag(idx)
			return "mt2009_dgend_"..math.floor(idx / 10000).."_"..math.mod(idx, 100)
		end

		function run_ended()
			local idx = pc.getf("wzgorze_wukonga", "idx")
			return idx > 0 and game.get_event_flag(wzgorze_wukonga.end_flag(idx)) >= pc.getf("wzgorze_wukonga", "entry")
		end

		-- In the instance (the boss's kill, the time limit): the event flag for those outside, the
		-- rejoin state of those inside. The daily count and the cooldown stay as the entry set them.
		function mark_ended()
			if d.getf("ended") == 1 then
				return
			end
			d.setf("ended", 1)
			d.setqf2("wzgorze_wukonga", "idx", 0)
			if d.getf("mt2009_dgbot") ~= 1 then
				game.set_event_flag(wzgorze_wukonga.end_flag(d.get_map_index()), get_global_time())
			end
		end

		-- A rejoin state with nothing behind it any more (the run ended, the time is up) is cleared;
		-- true when the run ended while the player was out of it.
		function clear_stale()
			local c = wzgorze_wukonga.cfg()
			if pc.getf("wzgorze_wukonga", "idx") <= 0 then
				return false
			end
			if wzgorze_wukonga.run_ended() then
				pc.setf("wzgorze_wukonga", "idx", 0)
				return true
			end
			if get_global_time() - pc.getf("wzgorze_wukonga", "entry") >= c.limit_min * 60 then
				pc.setf("wzgorze_wukonga", "idx", 0)
			end
			return false
		end

		function end_text(n)
			if n == 1 then
				return "Za 1 sekundê zostaniesz teleportowany do Œwi¹tyni Hwang."
			elseif n >= 2 and n <= 4 then
				return "Za "..n.." sekundy zostaniesz teleportowany do Œwi¹tyni Hwang."
			end
			return "Za "..n.." sekund zostaniesz teleportowany do Œwi¹tyni Hwang."
		end

		-- After the last boss: one notice a second, 5 to 0, then everyone out (finish).
		function end_count(n)
			d.notice("Wzgórze Wukonga: "..wzgorze_wukonga.end_text(n))
			if n <= 0 then
				wzgorze_wukonga.finish()
				return
			end
			d.setf("end_in", n - 1)
			server_timer("wukong_end", 1, d.get_map_index())
		end

		function entry_xy()
			local c = wzgorze_wukonga.cfg()
			return (c.base_x + c.entry[1]) * 100, (c.base_y + c.entry[2]) * 100
		end

		function purge_mobs()
			local c = wzgorze_wukonga.cfg()
			d.purge_area(c.base_x * 100, c.base_y * 100, (c.base_x + c.size) * 100, (c.base_y + c.size) * 100)
		end

		function stage_text(stage)
			local c = wzgorze_wukonga.cfg()
			if stage == 1 then return "Pokonajcie 60 ma³p, a potem u¿yjcie Pieczêci Wzgórza ("..d.getf("seals").."/"..c.seals..")."
			elseif stage == 2 then return "Zniszczcie 6 Kamieni Wzgórza."
			elseif stage == 3 then return "Pokonajcie 3 Obroñców Chmur."
			elseif stage == 4 then return "Zniszczcie 4 Jaja Feniksa."
			elseif stage == 5 then return "Pokonajcie P³omiennego Feniksa!"
			elseif stage == 6 then return "Pokonajcie WuKonga!"
			end
			return ""
		end

		function start_stage(stage)
			local c = wzgorze_wukonga.cfg()
			d.clear_regen()
			wzgorze_wukonga.purge_mobs()
			d.setf("stage", stage)
			d.setf("kills", 0)
			d.setf("seal_out", 0)
			if stage == 1 then
				d.set_regen_file(c.path.."wave.txt")
			elseif stage == 2 then
				d.setf("left", 6)
				d.regen_file(c.path.."stones.txt")
				d.set_regen_file(c.path.."guards.txt")
			elseif stage == 3 then
				d.setf("left", 3)
				wzgorze_wukonga.spawn_guardians()
				d.set_regen_file(c.path.."guards.txt")
			elseif stage == 4 then
				d.setf("left", 4)
				d.regen_file(c.path.."eggs.txt")
				d.set_regen_file(c.path.."guards.txt")
			elseif stage == 5 then
				-- 1 October: the bosses no longer stand on the entry point (264,273) on top of the party.
				d.spawn_mob(9684, 268, 256)
			elseif stage == 6 then
				d.spawn_mob(9682, 268, 256)
			end
			d.notice("Wzgórze Wukonga ("..stage.."/6): "..wzgorze_wukonga.stage_text(stage))
		end

		-- MT2009_PLUS_WUKONG_GUARDIANS_V1 (3 October): the Cloud Defenders one by one, each an instance
		-- unique. On the supporters' server a Defender's push carried a player's companion over the edge
		-- of the arena, a Defender went after it and stayed out there: nobody could reach it, the cape
		-- pulls no boss, and the run stood at "Pozosta³o: 1" until the players gave up. The core no
		-- longer pushes anyone onto blocked ground (char_skill.cpp, the same marker); this is the net
		-- under it. When no Defender has fallen for guardian_idle seconds, each one still at full
		-- health - nobody is hitting it - is put back on its place.
		function spawn_guardian(i)
			local c = wzgorze_wukonga.cfg()
			local vid = d.spawn_mob(9683, c.guardians[i][1], c.guardians[i][2])
			d.set_unique("wukong_guardian"..i, vid)
			d.setf("guardian"..i, vid)
		end

		function spawn_guardians()
			local c = wzgorze_wukonga.cfg()
			for i = 1, table.getn(c.guardians) do
				wzgorze_wukonga.spawn_guardian(i)
			end
			d.setf("guardian_time", get_global_time())
		end

		function guardian_down(vid)
			local c = wzgorze_wukonga.cfg()
			for i = 1, table.getn(c.guardians) do
				if d.getf("guardian"..i) == vid then
					d.setf("guardian"..i, 0)
				end
			end
			d.setf("guardian_time", get_global_time())
		end

		function guardians_check()
			local c = wzgorze_wukonga.cfg()
			if get_global_time() - d.getf("guardian_time") < c.guardian_idle then
				return
			end
			d.setf("guardian_time", get_global_time())
			local back = 0
			for i = 1, table.getn(c.guardians) do
				local key = "wukong_guardian"..i
				if d.getf("guardian"..i) ~= 0 and d.unique_get_hp_perc(key) >= 100 then
					d.purge_unique(key)
					wzgorze_wukonga.spawn_guardian(i)
					back = back + 1
				end
			end
			if back > 0 then
				d.notice("Wzgórze Wukonga: Obroñcy Chmur wracaj¹ na swoje miejsca.")
			end
		end

		function next_stage()
			local stage = d.getf("stage") + 1
			d.clear_regen()
			wzgorze_wukonga.purge_mobs()
			d.setf("stage", 9 + stage)
			d.notice("Wzgórze Wukonga: Etap zaliczony. Za 5 sekund nastêpne wyzwanie.")
			server_timer("wukong_stage", 5, d.get_map_index())
		end

		function seal_used()
			local c = wzgorze_wukonga.cfg()
			local s = d.getf("seals") + 1
			d.setf("seals", s)
			d.setf("seal_out", 0)
			d.setf("kills", 0)
			if s >= c.seals then
				wzgorze_wukonga.next_stage()
			else
				d.set_regen_file(c.path.."wave.txt")
				d.notice("Wzgórze Wukonga: Pieczêæ Wzgórza "..s.."/"..c.seals.." z³amana. Nadchodzi nastêpna fala!")
			end
		end

		function init()
			local c = wzgorze_wukonga.cfg()
			d.setf("init", 1)
			d.setf("entered", 1)
			-- MT2009_PLUS_DUNGEON_RETURN_V1: the instance outlives its players until the time limit.
			d.setf("mt2009_keep_until", get_global_time() + c.limit_min * 60 + 60)
			d.setf("start", get_global_time())
			d.setf("stage", 10)
			d.setf("seals", 0)
			d.setf("minutes", c.limit_min)
			d.notice("Wzgórze Wukonga: Witajcie. Za 5 sekund ma³py rusz¹ do ataku.")
			server_timer("wukong_stage", 5, d.get_map_index())
			server_timer("wukong_tick", 60, d.get_map_index())
		end

		function finish()
			wzgorze_wukonga.mark_ended() -- MT2009_PLUS_DUNGEON_END_V1
			local c = wzgorze_wukonga.cfg()
			d.setf("closed", 1)
			d.setf("mt2009_keep_until", 0)
			if d.getf("mt2009_dgbot") == 1 then
				-- MT2009_PLUS_AREZZO_DUNGEON_BOTS_V1: the test cohort's run ends in its lobby (this map, game2).
				d.set_warp_location(c.map, c.base_x + c.entry[1], c.base_y + c.entry[2])
			else
				d.set_warp_location(c.exit_map, c.exit_x, c.exit_y)
			end
			d.exit_all()
		end

		function reward()
			local c = wzgorze_wukonga.cfg()
			local took = get_global_time() - d.getf("start")
			local pids = {}
			if party.is_party() then
				pids = {party.get_member_pids()}
			end
			if table.getn(pids) == 0 then
				pids = {pc.get_player_id()}
			end
			for i, pid in next, pids, nil do
				q.begin_other_pc_block(pid)
				if not pc.is_playerbot() then
					local n = number(c.chests_min, c.chests_max)
					pc.give_item2(30774, n)
					syschat("Wzgórze Wukonga: otrzymujesz skrzynie: "..n..".")
				end
				q.end_other_pc_block()
			end
			return took
		end

		when 20423.chat."Wzgórze Wukonga" with pc.get_map_index() ~= 364 and not wzgorze_wukonga.inside() begin
			local c = wzgorze_wukonga.cfg()
			say_title(mob_name(20423))
			if pc.is_playerbot() then
				return
			end
			say("Na Wzgórzu zamieszka³y ma³py mistrza WuKonga.")
			say("Ich stra¿nicy pilnuj¹ P³omiennego Feniksa,")
			say("a sam WuKong czeka na œmia³ków na szczycie.")
			say("")
			say_reward("Wymagany poziom: "..c.min_level..". Limit "..c.limit_min.." minut, ponowne wejœcie po "..math.floor(c.cooldown / 60).." minutach.")
			say_reward("Loch jest tylko dla graczy - boty z dru¿yny zostaj¹ tutaj.")
			say_reward("Wejœcie: "..c.fee_text.." Yang. Najwy¿ej "..c.daily.." wypraw dziennie (dziœ: "..wzgorze_wukonga.runs_today().."/"..c.daily..").") -- MT2009_PLUS_DUNGEON_FEE_V1
			if select("WejdŸ do lochu", "Nie teraz") ~= 1 then
				return
			end
			if not pc.is_gm() and game.get_event_flag("mt2009_arezzo_closed") > 0 then
				say_title(mob_name(20423))
				say("Przejœcie jest jeszcze zamkniête. Wróæ póŸniej.")
				return
			end
			local now = get_global_time()
			local x, y = wzgorze_wukonga.entry_xy()
			-- MT2009_PLUS_DUNGEON_END_V1: a run that ended while the player was out is no longer his.
			if wzgorze_wukonga.clear_stale() then
				say_title(mob_name(20423))
				say("Ten loch zosta³ ju¿ ukoñczony.")
			end
			local idx = pc.getf("wzgorze_wukonga", "idx")
			if idx > 0 and now - pc.getf("wzgorze_wukonga", "entry") < c.limit_min * 60 then
				say_title(mob_name(20423))
				say("Twoja wyprawa wci¹¿ trwa. Czy chcesz do niej wróciæ?")
				local s
				if pc.is_gm() then
					s = select("Wróæ do lochu", "Nowa wyprawa (GM)", "Nie teraz")
				else
					s = select("Wróæ do lochu", "Nie teraz")
					if s == 2 then s = 3 end
				end
				if s == 3 then
					return
				elseif s == 1 then
					-- MT2009_PLUS_DUNGEON_END_V1: the login inside knows this jump (no second fee).
					pc.setf("wzgorze_wukonga", "back", idx)
					pc.setf("wzgorze_wukonga", "back_at", now)
					if d.find(idx, x, y, pc.get_player_id()) then
						pc.warp(x, y, idx)
					else
						say_title(mob_name(20423))
						say("Jeœli wyprawa wci¹¿ trwa, przejœcie zaraz ciê zabierze.")
						timer("wukong_rejoin", 5)
					end
					return
				end
			end
			if party.is_party() and not party.is_leader() then
				say_title(mob_name(20423))
				say("Tylko przywódca dru¿yny mo¿e otworzyæ przejœcie.")
				say("Stañ przy mnie - przywódca zabierze dru¿ynê stoj¹c¹ obok.")
				return
			end
			if pc.get_level() < c.min_level then
				say_title(mob_name(20423))
				say("Jesteœ za s³aby. Wróæ, gdy osi¹gniesz poziom "..c.min_level..".")
				return
			end
			if not pc.can_warp() or pc.is_busy() then
				say_title(mob_name(20423))
				say("Poczekaj chwilê po handlu lub rozmowie i spróbuj ponownie.")
				return
			end
			if now - pc.getf("wzgorze_wukonga", "pending") < 10 then
				say_title(mob_name(20423))
				say("Przejœcie ju¿ siê otwiera. Poczekaj chwilê.")
				return
			end
			local me = pc.get_player_id()
			local humans = {me}
			local low = {}
			local wait = {}
			local full = {} -- MT2009_PLUS_DUNGEON_FEE_V1
			local poor = {}
			if not pc.is_gm() and now - pc.getf("wzgorze_wukonga", "entry") < c.cooldown then
				table.insert(wait, pc.get_name())
			end
			if wzgorze_wukonga.over_limit() then table.insert(full, pc.get_name()) end
			if wzgorze_wukonga.too_poor() then table.insert(poor, pc.get_name()) end
			if party.is_party() then
				local lmap, lx, ly = pc.get_map_index(), pc.get_x(), pc.get_y()
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					if pid ~= me then
						q.begin_other_pc_block(pid)
						local dx, dy = pc.get_x() - lx, pc.get_y() - ly
						if not pc.is_playerbot() and pc.get_map_index() == lmap and dx * dx + dy * dy <= c.near * c.near and pc.can_warp() then
							table.insert(humans, pid)
							if pc.get_level() < c.min_level then
								table.insert(low, pc.get_name())
							end
							if not pc.is_gm() and now - pc.getf("wzgorze_wukonga", "entry") < c.cooldown then
								table.insert(wait, pc.get_name())
							end
							if wzgorze_wukonga.over_limit() then table.insert(full, pc.get_name()) end
							if wzgorze_wukonga.too_poor() then table.insert(poor, pc.get_name()) end
						end
						q.end_other_pc_block()
					end
				end
			end
			if table.getn(low) > 0 then
				say_title(mob_name(20423))
				say("Za s³abi, by wejœæ (poziom "..c.min_level.."+):")
				for i, n in next, low, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(full) > 0 then
				say("Dzisiejsze wyprawy do tego lochu ju¿ wykorzystane ("..c.daily.." dziennie):")
				for i, n in next, full, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(poor) > 0 then
				say("Wejœcie kosztuje "..c.fee_text.." Yang - za ma³o przy sobie:")
				for i, n in next, poor, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(wait) > 0 then
				say_title(mob_name(20423))
				say("Jeszcze nie odpoczêli po poprzedniej wyprawie:")
				for i, n in next, wait, nil do say(color(1,1,0).."    "..n) end
				local left = c.cooldown - (now - pc.getf("wzgorze_wukonga", "entry"))
				if left > 0 then
					say("")
					say("Ty mo¿esz wejœæ za "..math.ceil(left / 60).." min.")
				end
				return
			end
			local r = d.new_jump_pids(c.map, x, y, humans)
			if r < 0 then
				wzgorze_wukonga.lobby()
				return
			end
			pc.setf("wzgorze_wukonga", "pending", now)
			if r == 0 then
				timer("wukong_fallback", 5)
			end
		end

		function lobby()
			local c = wzgorze_wukonga.cfg()
			local x, y = wzgorze_wukonga.entry_xy()
			if party.is_party() then
				local me = pc.get_player_id()
				local lmap, lx, ly = pc.get_map_index(), pc.get_x(), pc.get_y()
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					if pid ~= me then
						q.begin_other_pc_block(pid)
						local dx, dy = pc.get_x() - lx, pc.get_y() - ly
						if not pc.is_playerbot() and pc.get_map_index() == lmap and dx * dx + dy * dy <= c.near * c.near and pc.can_warp() then
							pc.warp(x, y)
						end
						q.end_other_pc_block()
					end
				end
			else
				pc.setf("wzgorze_wukonga", "auto", 1)
			end
			pc.setf("wzgorze_wukonga", "pending", 0)
			pc.warp(x, y)
		end

		when wukong_fallback.timer begin
			local c = wzgorze_wukonga.cfg()
			if pc.get_map_index() ~= c.exit_map or pc.getf("wzgorze_wukonga", "pending") == 0 then
				return
			end
			syschat("Wzgórze Wukonga: przejœcie prowadzi przez poczekalniê.")
			wzgorze_wukonga.lobby()
		end

		function lobby_create(humans)
			local c = wzgorze_wukonga.cfg()
			local x, y = wzgorze_wukonga.entry_xy()
			local list = {pc.get_player_id()}
			for i, pid in next, humans, nil do
				if pid ~= list[1] then
					table.insert(list, pid)
				end
			end
			return d.new_jump_pids(c.map, x, y, list) > 0
		end

		when 20423.chat."Otwórz przejœcie" with pc.get_map_index() == 364 begin
			local c = wzgorze_wukonga.cfg()
			say_title(mob_name(20423))
			local now = get_global_time()
			-- MT2009_PLUS_DUNGEON_END_V1: an ended run is no longer the player's; the lobby stands on the
			-- instances' own core, so d.find here also tells an instance that is gone.
			if wzgorze_wukonga.clear_stale() then
				say("Ten loch zosta³ ju¿ ukoñczony.")
			end
			local idx = pc.getf("wzgorze_wukonga", "idx")
			if idx > 0 and now - pc.getf("wzgorze_wukonga", "entry") < c.limit_min * 60 then
				if d.find(idx) then
					say("Twoja wyprawa wci¹¿ trwa. Czy chcesz do niej wróciæ?")
					if select("Wróæ do lochu", "Nie teraz") == 1 then
						local x, y = wzgorze_wukonga.entry_xy()
						pc.warp(x, y, idx)
					end
					return
				end
				pc.setf("wzgorze_wukonga", "idx", 0)
			end
			if party.is_party() and not party.is_leader() then
				say("Tylko przywódca dru¿yny mo¿e otworzyæ przejœcie.")
				say("Poczekaj tu na niego - zabierze ca³¹ dru¿ynê.")
				return
			end
			local humans = {}
			local low = {}
			local wait = {}
			local full = {} -- MT2009_PLUS_DUNGEON_FEE_V1
			local poor = {}
			if party.is_party() then
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					q.begin_other_pc_block(pid)
					if not pc.is_playerbot() then
						table.insert(humans, pid)
						if pc.get_level() < c.min_level then
							table.insert(low, pc.get_name())
						end
						if not pc.is_gm() and now - pc.getf("wzgorze_wukonga", "entry") < c.cooldown then
							table.insert(wait, pc.get_name())
						end
						if wzgorze_wukonga.over_limit() then table.insert(full, pc.get_name()) end
						if wzgorze_wukonga.too_poor() then table.insert(poor, pc.get_name()) end
					end
					q.end_other_pc_block()
				end
			else
				table.insert(humans, pc.get_player_id())
				if pc.get_level() < c.min_level then
					table.insert(low, pc.get_name())
				end
				if not pc.is_gm() and now - pc.getf("wzgorze_wukonga", "entry") < c.cooldown then
					table.insert(wait, pc.get_name())
				end
				if wzgorze_wukonga.over_limit() then table.insert(full, pc.get_name()) end
				if wzgorze_wukonga.too_poor() then table.insert(poor, pc.get_name()) end
			end
			if table.getn(low) > 0 then
				say("Za s³abi, by wejœæ (poziom "..c.min_level.."+):")
				for i, n in next, low, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(full) > 0 then
				say("Dzisiejsze wyprawy do tego lochu ju¿ wykorzystane ("..c.daily.." dziennie):")
				for i, n in next, full, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(poor) > 0 then
				say("Wejœcie kosztuje "..c.fee_text.." Yang - za ma³o przy sobie:")
				for i, n in next, poor, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(wait) > 0 then
				say("Jeszcze nie odpoczêli po poprzedniej wyprawie:")
				for i, n in next, wait, nil do say(color(1,1,0).."    "..n) end
				return
			end
			say("Dru¿yna na tej mapie wejdzie razem z tob¹.")
			if select("Otwórz przejœcie", "Nie teraz") ~= 1 then
				return
			end
			if not wzgorze_wukonga.lobby_create(humans) then
				say_title(mob_name(20423))
				say("Nie uda³o siê otworzyæ przejœcia. Spróbuj ponownie za chwilê.")
			end
		end

		when wukong_auto.timer begin
			local c = wzgorze_wukonga.cfg()
			if pc.get_map_index() ~= c.map or party.is_party() then
				return
			end
			local now = get_global_time()
			if pc.get_level() < c.min_level or (not pc.is_gm() and now - pc.getf("wzgorze_wukonga", "entry") < c.cooldown) then
				syschat("Wzgórze Wukonga: porozmawiaj ze stra¿nikiem, aby otworzyæ przejœcie.")
				return
			end
			if not wzgorze_wukonga.lobby_create({pc.get_player_id()}) then
				syschat("Wzgórze Wukonga: nie uda³o siê otworzyæ przejœcia - porozmawiaj ze stra¿nikiem.")
			end
		end

		-- MT2009_PLUS_DUNGEON_END_V1: "Wróæ do lochu" went to another core (d.find) and nobody took the
		-- player there within 5 seconds: the instance is gone, and so is the rejoin state.
		when wukong_rejoin.timer begin
			if wzgorze_wukonga.inside() or pc.getf("wzgorze_wukonga", "idx") <= 0 then
				return
			end
			pc.setf("wzgorze_wukonga", "idx", 0)
			syschat("Wzgórze Wukonga: Ta wyprawa ju¿ siê zakoñczy³a. Porozmawiaj ze stra¿nikiem, aby wyruszyæ na now¹.")
		end

		when login begin
			local c = wzgorze_wukonga.cfg()
			local idx = pc.get_map_index()
			if idx == c.map then
				if pc.is_playerbot() then
					pc.warp(c.exit_x * 100, c.exit_y * 100)
					return
				end
				pc.set_warp_location(c.exit_map, c.exit_x, c.exit_y)
				pc.setf("wzgorze_wukonga", "pending", 0)
				if pc.getf("wzgorze_wukonga", "auto") == 1 and not party.is_party() then
					pc.setf("wzgorze_wukonga", "auto", 0)
					syschat("Wzgórze Wukonga: przejœcie siê otwiera...")
					timer("wukong_auto", 1)
				else
					pc.setf("wzgorze_wukonga", "auto", 0)
					syschat("Wzgórze Wukonga: porozmawiaj ze stra¿nikiem, aby otworzyæ przejœcie.")
				end
			elseif wzgorze_wukonga.inside() then
				if pc.is_playerbot() then
					pc.warp(c.exit_x * 100, c.exit_y * 100)
					return
				end
				pc.set_warp_location(c.exit_map, c.exit_x, c.exit_y)
				pc.setf("wzgorze_wukonga", "inside", 1)
				pc.setf("wzgorze_wukonga", "pending", 0)
				-- MT2009_PLUS_DUNGEON_END_V1: an instance whose last boss is down (or whose time is up) takes
				-- nobody back in, and costs nothing.
				if d.getf("ended") == 1 or d.getf("closed") == 1 then
					if pc.getf("wzgorze_wukonga", "idx") == idx then
						pc.setf("wzgorze_wukonga", "idx", 0)
					end
					syschat("Wzgórze Wukonga: Ten loch zosta³ ju¿ ukoñczony.")
					pc.warp(c.exit_x * 100, c.exit_y * 100)
					return
				end
				-- the guard's "Wróæ do lochu" (its 5-second check may have cleared the state while the jump ran)
				local back = pc.getf("wzgorze_wukonga", "back") == idx and get_global_time() - pc.getf("wzgorze_wukonga", "back_at") < 60
				pc.setf("wzgorze_wukonga", "back", 0)
				if pc.getf("wzgorze_wukonga", "idx") ~= idx then
					if back then
						pc.setf("wzgorze_wukonga", "idx", idx)
					else
						if not wzgorze_wukonga.pay_entry() then -- MT2009_PLUS_DUNGEON_FEE_V1
							pc.warp(c.exit_x * 100, c.exit_y * 100)
							return
						end
						pc.setf("wzgorze_wukonga", "idx", idx)
						pc.setf("wzgorze_wukonga", "entry", get_global_time())
					end
				end
				if d.getf("init") == 0 then
					wzgorze_wukonga.init()
				end
			else
				if pc.getf("wzgorze_wukonga", "inside") == 1 then
					pc.setf("wzgorze_wukonga", "inside", 0)
					if pc.count_item(30766) > 0 then pc.remove_item(30766, pc.count_item(30766)) end
				end
				-- MT2009_PLUS_DUNGEON_END_V1: the run ended while the player was out of it (or its time is up).
				if not pc.is_playerbot() and wzgorze_wukonga.clear_stale() then
					syschat("Wzgórze Wukonga: Ten loch zosta³ ju¿ ukoñczony.")
				end
			end
		end

		when wukong_stage.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("closed") == 1 then
					return
				end
				local s = d.getf("stage")
				if s >= 10 then
					wzgorze_wukonga.start_stage(s - 9)
				end
			end
		end

		when wukong_tick.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("closed") == 1 then
					return
				end
				local left = d.getf("minutes") - 1
				if d.getf("mt2009_dgbot") == 1 then
					-- MT2009_PLUS_AREZZO_DUNGEON_BOTS_V1: the test cohort's runs have no time limit.
					left = d.getf("minutes")
				end
				d.setf("minutes", left)
				if left <= 0 then
					d.notice("Wzgórze Wukonga: Czas min¹³. Stra¿nik wyprowadza was z lochu.")
					wzgorze_wukonga.finish()
					return
				end
				if d.getf("stage") == 1 and d.getf("seal_out") == 1 and get_global_time() - d.getf("seal_time") > 180 then
					d.notice("Wzgórze Wukonga: Pieczêæ Wzgórza zadzia³a³a sama.")
					wzgorze_wukonga.seal_used()
				end
				if left == 15 or left == 10 or left == 5 or left == 1 then
					d.notice("Wzgórze Wukonga: Pozosta³o "..left.." min.")
				end
				if d.getf("stage") == 3 then
					wzgorze_wukonga.guardians_check() -- MT2009_PLUS_WUKONG_GUARDIANS_V1
				end
				server_timer("wukong_tick", 60, get_server_timer_arg())
			end
		end

		-- MT2009_PLUS_AREZZO_DUNGEON_BOTS_V1: the start of a test cohort's run. The core makes the
		-- instance itself (no guard, so no fee and no daily limit), marks it with the dungeon flag
		-- mt2009_dgbot - nothing a player can set - and asks for this; a player's run starts in login.
		when wukong_dgbot.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("mt2009_dgbot") == 1 and d.getf("init") == 0 then
					wzgorze_wukonga.init()
				end
			end
		end

		-- MT2009_PLUS_DUNGEON_END_V1: the countdown after the last boss (end_count), a second at a time.
		when wukong_end.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("closed") == 1 then
					return
				end
				wzgorze_wukonga.end_count(d.getf("end_in"))
			end
		end

		when 9690.kill or 9691.kill or 9692.kill or 9693.kill with wzgorze_wukonga.inside() and d.getf("stage") == 1 and d.getf("seal_out") == 0 begin
			local c = wzgorze_wukonga.cfg()
			local k = d.getf("kills") + 1
			d.setf("kills", k)
			if k >= c.wave_kills then
				d.setf("seal_out", 1)
				d.clear_regen()
				wzgorze_wukonga.purge_mobs()
				d.setf("seal_time", get_global_time())
				pc.give_item2(30766, 1)
				d.notice("Wzgórze Wukonga: "..pc.get_name().." zdobywa Pieczêæ Wzgórza. U¿yj jej, aby przyzwaæ nastêpn¹ falê.")
			elseif math.mod(k, 20) == 0 then
				d.notice("Wzgórze Wukonga: Pokonane potwory: "..k.." / "..c.wave_kills)
			end
		end

		when 30766.use begin
			if not wzgorze_wukonga.inside() or d.getf("stage") ~= 1 or d.getf("seal_out") ~= 1 then
				syschat("Pieczêæ Wzgórza mo¿na u¿yæ tylko w lochu, po pokonaniu fali potworów.")
				return
			end
			pc.remove_item(30766, 1)
			wzgorze_wukonga.seal_used()
		end

		when 9701.kill with wzgorze_wukonga.inside() and d.getf("stage") == 2 begin
			local left = d.getf("left") - 1
			d.setf("left", left)
			if left <= 0 then
				wzgorze_wukonga.next_stage()
			else
				d.notice("Wzgórze Wukonga: Pozosta³o: "..left)
			end
		end

		when 9683.kill with wzgorze_wukonga.inside() and d.getf("stage") == 3 begin
			wzgorze_wukonga.guardian_down(npc.get_vid()) -- MT2009_PLUS_WUKONG_GUARDIANS_V1
			local left = d.getf("left") - 1
			d.setf("left", left)
			if left <= 0 then
				wzgorze_wukonga.next_stage()
			else
				d.notice("Wzgórze Wukonga: Pozosta³o: "..left)
			end
		end

		when 9702.kill with wzgorze_wukonga.inside() and d.getf("stage") == 4 begin
			local left = d.getf("left") - 1
			d.setf("left", left)
			if left <= 0 then
				wzgorze_wukonga.next_stage()
			else
				d.notice("Wzgórze Wukonga: Pozosta³o: "..left)
			end
		end

		when 9684.kill with wzgorze_wukonga.inside() and d.getf("stage") == 5 begin
			wzgorze_wukonga.next_stage()
		end

		when 9682.kill with wzgorze_wukonga.inside() and d.getf("stage") == 6 begin
			if d.getf("stage") == 6 then
				d.setf("stage", 7)
				d.clear_regen()
				wzgorze_wukonga.purge_mobs()
				local took = wzgorze_wukonga.reward()
				d.update_ranking("wukong", took) -- MT2009_PLUS_DUNGEON_PANEL_V1
				-- MT2009_PLUS_DUNGEON_END_V1: the run is over for everyone in it (no "Wróæ do lochu" any more),
				-- and five seconds later everyone is out (was a minute).
				wzgorze_wukonga.mark_ended()
				d.notice(string.format("WuKong pokonany! Czas: %d:%02d. Loch zosta³ ukoñczony.", math.floor(took / 60), math.mod(took, 60)))
				wzgorze_wukonga.end_count(5)
				return
			end
		end
	end
end
