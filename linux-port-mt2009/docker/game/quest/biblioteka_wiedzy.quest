-- MT2009_PLUS_AREZZO_V1 (biblioteka): Biblioteka Wiedzy - loch paj¹ków od poziomu 30, tylko
-- dla graczy. Mapa i uk³ad z Arezzo (plechito_chamber_of_wisdom, quest dungeon_wisdom),
-- przebieg napisany od nowa na wzorcu razador_dungeon.quest: Stra¿nik Biblioteki (20430)
-- w M2 ka¿dego królestwa (obok Teleportera; do 30 wrzeœnia w Dolinie Orków) tworzy instancjê mapy 363 na game2
-- (d.new_jump_pids) i od razu przenosi do niej gracza albo przywódcê z ludŸmi jego
-- dru¿yny stoj¹cymi obok (jedno ³adowanie, boty zostaj¹ na zewn¹trz). Etapy:
--   1: zabij 60 paj¹ków (9703) - zabójca dostaje Pieczêæ Biblioteki (30765); u¿ycie
--      pieczêci wzywa nastêpn¹ falê; trzy pieczêcie koñcz¹ etap (Arezzo: 150 x 5),
--   2: zniszcz 5 Metinów (8006, Metin Ciemnoœci, jak Metiny u Arezzo; do 1 paŸdziernika Pajêcze Jaja
--      9704 z modelem spider_spawn, nie Metiny - "Dung 30 lvl nie ma metinów"),
--   3: pokonaj 3 Królowe Paj¹ków (9705),
--   4: zniszcz 4 Metiny,
--   5: Baronówna Paj¹ków (9706); po jej œmierci ka¿dy gracz w lochu dostaje 1-3
--      Skrzynie Biblioteki (30773), a wszyscy wychodz¹ po 5 sekundach (MT2009_PLUS_DUNGEON_END_V1).
-- Limit 30 minut, ponowne wejœcie po 30 minutach od wejœcia. B³êdy questa Arezzo nie s¹
-- przeniesione (warunki "or"/"and" bez nawiasów, brak return po pc.can_warp, przepustki
-- zabierane czêœci dru¿yny). Dla panelu lochów (faza 4) ka¿dy gracz ma flagi
-- biblioteka_wiedzy.finish (ukoñczenia), .best_time i .last_time (sekundy).
-- MT2009_PLUS_BIBLIOTEKA_BALANCE_V1 (w³aœciciel, 2 paŸdziernika): potwory lochu (9703, 9705, 9706)
-- bij¹ o 20% mocniej (dam_multiply w playerbot/apply.sh), Metiny (8006) maj¹ tu 55% ¿ycia,
-- a Baronówna ¿ycie i regeneracjê Wodza Orków (691) razy liczba graczy w instancji przy jej
-- pojawieniu siê (boty licz¹ siê tak¿e): 1 - 100%, 2 - 150%, 3 - 200%, 4 i wiêcej - 300%;
-- regeneracja leczy tyle punktów co przy jednym graczu.
-- d.count_players i d.mob_hp_percent: server-patches/dungeonhp (MT2009_PLUS_DUNGEON_MOB_HP_V1).
quest biblioteka_wiedzy begin
	state start begin
		function cfg()
			return {
				map = 363,
				base_x = 9472, base_y = 6144, size = 512,
				entry = {271, 252},
				boss = {271, 290},
				exit_map = 64, exit_x = 2560 + 292, exit_y = 6656 + 1452,
				min_level = 30,
				near = 30,
				cooldown = 30 * 60,
				limit_min = 30,
				-- MT2009_PLUS_DUNGEON_FEE_V1: the price of a new expedition (each player, paid on entering it) and
				-- how many new expeditions a player may start a day (Polish midnight).
				fee = 2000000, fee_text = "2 000 000",
				daily = 5,
				wave_kills = 60,
				seals = 3,
				chests_min = 1, chests_max = 3,
				path = "data/dungeon/biblioteka_wiedzy/",
			}
		end

		-- MT2009_PLUS_DUNGEON_FEE_V1: the entry fee and the daily limit. Checked for everyone at the guard (with
		-- the level and the rest), paid on the first login into a new instance (every way in:
		-- the guard, the lobby, the lobby's own timer) - no money or no runs left there sends
		-- the player out. "Wróæ do lochu" into the same instance costs nothing. GMs are free.
		function today()
			return math.floor((get_global_time() + 7200) / 86400)
		end

		function runs_today()
			if pc.getf("biblioteka_wiedzy", "day") ~= biblioteka_wiedzy.today() then
				return 0
			end
			return pc.getf("biblioteka_wiedzy", "runs")
		end

		function over_limit()
			local c = biblioteka_wiedzy.cfg()
			return not pc.is_gm() and biblioteka_wiedzy.runs_today() >= c.daily
		end

		function too_poor()
			local c = biblioteka_wiedzy.cfg()
			return not pc.is_gm() and pc.get_money() < c.fee
		end

		function pay_entry()
			local c = biblioteka_wiedzy.cfg()
			if pc.is_gm() or pc.is_playerbot() then
				return true
			end
			if biblioteka_wiedzy.over_limit() then
				syschat("Wykorzysta³eœ ju¿ dzisiejsze wyprawy do tego lochu ("..c.daily.."). Wróæ jutro.")
				return false
			end
			if pc.get_money() < c.fee then
				syschat("Wejœcie kosztuje "..c.fee_text.." Yang - nie masz tyle przy sobie.")
				return false
			end
			pc.change_money(-c.fee)
			local day = biblioteka_wiedzy.today()
			if pc.getf("biblioteka_wiedzy", "day") ~= day then
				pc.setf("biblioteka_wiedzy", "day", day)
				pc.setf("biblioteka_wiedzy", "runs", 0)
			end
			pc.setf("biblioteka_wiedzy", "runs", pc.getf("biblioteka_wiedzy", "runs") + 1)
			syschat("Op³ata za wejœcie: "..c.fee_text.." Yang. Dzisiejsza wyprawa "..pc.getf("biblioteka_wiedzy", "runs").."/"..c.daily..".")
			return true
		end

		function inside()
			local idx = pc.get_map_index()
			return idx >= 363 * 10000 and idx < 364 * 10000
		end

		-- MT2009_PLUS_DUNGEON_END_V1 (2 October): the end of a run, seen from every core. A player used a
		-- Teleport Ring in the minute after the boss, and his guard (another core: d.find cannot tell what
		-- game2 holds) kept offering "Wróæ do lochu" into an instance that was gone. The boss's kill (or the
		-- time limit) now writes the end time to an event flag of the instance's slot (map and the last two
		-- digits of its index - a slot comes round again only after 100 more instances of the map), and
		-- every core compares it with the player's own entry time: a run that ended after he went in is over.
		function end_flag(idx)
			return "mt2009_dgend_"..math.floor(idx / 10000).."_"..math.mod(idx, 100)
		end

		function run_ended()
			local idx = pc.getf("biblioteka_wiedzy", "idx")
			return idx > 0 and game.get_event_flag(biblioteka_wiedzy.end_flag(idx)) >= pc.getf("biblioteka_wiedzy", "entry")
		end

		-- In the instance (the boss's kill, the time limit): the event flag for those outside, the
		-- rejoin state of those inside. The daily count and the cooldown stay as the entry set them.
		function mark_ended()
			if d.getf("ended") == 1 then
				return
			end
			d.setf("ended", 1)
			d.setqf2("biblioteka_wiedzy", "idx", 0)
			if d.getf("mt2009_dgbot") ~= 1 then
				game.set_event_flag(biblioteka_wiedzy.end_flag(d.get_map_index()), get_global_time())
			end
		end

		-- A rejoin state with nothing behind it any more (the run ended, the time is up) is cleared;
		-- true when the run ended while the player was out of it.
		function clear_stale()
			local c = biblioteka_wiedzy.cfg()
			if pc.getf("biblioteka_wiedzy", "idx") <= 0 then
				return false
			end
			if biblioteka_wiedzy.run_ended() then
				pc.setf("biblioteka_wiedzy", "idx", 0)
				return true
			end
			if get_global_time() - pc.getf("biblioteka_wiedzy", "entry") >= c.limit_min * 60 then
				pc.setf("biblioteka_wiedzy", "idx", 0)
			end
			return false
		end

		function end_text(n)
			if n == 1 then
				return "Za 1 sekundê zostaniesz teleportowany do miasta."
			elseif n >= 2 and n <= 4 then
				return "Za "..n.." sekundy zostaniesz teleportowany do miasta."
			end
			return "Za "..n.." sekund zostaniesz teleportowany do miasta."
		end

		-- After the last boss: one notice a second, 5 to 0, then everyone out (finish).
		function end_count(n)
			d.notice("Biblioteka Wiedzy: "..biblioteka_wiedzy.end_text(n))
			if n <= 0 then
				biblioteka_wiedzy.finish()
				return
			end
			d.setf("end_in", n - 1)
			server_timer("biblioteka_end", 1, d.get_map_index())
		end

		function entry_xy()
			local c = biblioteka_wiedzy.cfg()
			return (c.base_x + c.entry[1]) * 100, (c.base_y + c.entry[2]) * 100
		end

		function purge_mobs()
			local c = biblioteka_wiedzy.cfg()
			d.purge_area(c.base_x * 100, c.base_y * 100, (c.base_x + c.size) * 100, (c.base_y + c.size) * 100)
		end

		function stage_text(stage)
			local c = biblioteka_wiedzy.cfg()
			if stage == 1 then return "Pokonajcie "..c.wave_kills.." paj¹ków, a potem u¿yjcie Pieczêci Biblioteki ("..d.getf("seals").."/"..c.seals..")."
			elseif stage == 2 then return "Zniszczcie 5 Metinów."
			elseif stage == 3 then return "Pokonajcie 3 Królowe Paj¹ków."
			elseif stage == 4 then return "Zniszczcie 4 Metiny."
			end
			return "Pokonajcie Baronównê Paj¹ków!"
		end

		-- MT2009_PLUS_BIBLIOTEKA_BALANCE_V1: the Metins of stages 2 and 4 at 55% of their health
		-- (only here - the world's 8006 keep theirs).
		function weaken_metins()
			if d.mob_hp_percent then
				d.mob_hp_percent(8006, 55)
			end
		end

		-- MT2009_PLUS_BIBLIOTEKA_BALANCE_V1: the Baroness's health by the players in the instance
		-- when she comes (bots too): 1 - as she is, 2 - +50%, 3 - +100%, 4 or more - +200%.
		-- Her regeneration heals the same points as with one player: the engine counts regen_percent
		-- from her health before the rescale (MT2009_PLUS_DUNGEON_MOB_HP_V2).
		function boss_hp_percent(players)
			if players >= 4 then return 300
			elseif players == 3 then return 200
			elseif players == 2 then return 150
			end
			return 100
		end

		function scale_boss()
			if not d.count_players or not d.mob_hp_percent then
				return
			end
			local n = d.count_players()
			local pct = biblioteka_wiedzy.boss_hp_percent(n)
			if pct > 100 then
				d.mob_hp_percent(9706, pct)
				d.notice("Biblioteka Wiedzy: Baronówna wyczuwa "..n.." œmia³ków - ma "..(pct - 100).."% wiêcej ¿ycia.")
			end
		end

		-- The stages. Each one clears what the previous left and spawns its own.
		function start_stage(stage)
			local c = biblioteka_wiedzy.cfg()
			d.clear_regen()
			biblioteka_wiedzy.purge_mobs()
			d.setf("stage", stage)
			d.setf("kills", 0)
			d.setf("seal_out", 0)
			if stage == 1 then
				d.set_regen_file(c.path.."wave.txt")
			elseif stage == 2 then
				d.setf("left", 5)
				d.regen_file(c.path.."eggs5.txt")
				biblioteka_wiedzy.weaken_metins()
				d.set_regen_file(c.path.."guards.txt")
			elseif stage == 3 then
				d.setf("left", 3)
				d.regen_file(c.path.."queens.txt")
				d.set_regen_file(c.path.."guards.txt")
			elseif stage == 4 then
				d.setf("left", 4)
				d.regen_file(c.path.."eggs4.txt")
				biblioteka_wiedzy.weaken_metins()
				d.set_regen_file(c.path.."guards.txt")
			elseif stage == 5 then
				d.spawn_mob(9706, c.boss[1], c.boss[2])
				biblioteka_wiedzy.scale_boss()
				d.set_regen_file(c.path.."guards.txt")
			end
			d.notice("Biblioteka Wiedzy ("..stage.."/5): "..biblioteka_wiedzy.stage_text(stage))
		end

		function next_stage()
			local stage = d.getf("stage") + 1
			d.clear_regen()
			biblioteka_wiedzy.purge_mobs()
			d.setf("stage", 9 + stage)	-- between stages: no kill counts
			d.notice("Biblioteka Wiedzy: Etap zaliczony. Za 5 sekund nastêpne wyzwanie.")
			server_timer("biblioteka_stage", 5, d.get_map_index())
		end

		function seal_used()
			local c = biblioteka_wiedzy.cfg()
			local s = d.getf("seals") + 1
			d.setf("seals", s)
			d.setf("seal_out", 0)
			d.setf("kills", 0)
			if s >= c.seals then
				biblioteka_wiedzy.next_stage()
			else
				d.set_regen_file(c.path.."wave.txt")
				d.notice("Biblioteka Wiedzy: Pieczêæ "..s.."/"..c.seals.." z³amana. Nadchodzi nastêpna fala!")
			end
		end

		function init()
			local c = biblioteka_wiedzy.cfg()
			d.setf("init", 1)
			d.setf("entered", 1)
			-- MT2009_PLUS_DUNGEON_RETURN_V1: the instance outlives its players until the time limit.
			d.setf("mt2009_keep_until", get_global_time() + c.limit_min * 60 + 60)
			d.setf("start", get_global_time())
			d.setf("stage", 10)
			d.setf("seals", 0)
			d.setf("minutes", c.limit_min)
			d.notice("Biblioteka Wiedzy: Witajcie. Za 5 sekund z pó³ek wype³zn¹ paj¹ki.")
			server_timer("biblioteka_stage", 5, d.get_map_index())
			server_timer("biblioteka_tick", 60, d.get_map_index())
		end

		function finish()
			biblioteka_wiedzy.mark_ended() -- MT2009_PLUS_DUNGEON_END_V1
			d.setf("closed", 1)
			d.setf("mt2009_keep_until", 0)
			-- MT2009_PLUS_DUNGEON_FEE_V1: everyone goes back to his own empire's M2 (the location
			-- each login inside saved with exit_xy), so no one warp location for the instance.
			d.exit_all()
		end

		-- MT2009_PLUS_DUNGEON_FEE_V1: Straznik Biblioteki stands in every empire's M2 by the
		-- Teleporter (playerbot_arezzo.h spawns him); the way out leads back there.
		function exit_xy()
			local e = pc.get_empire()
			if e == 2 then
				return 23, 1024 + 345, 2048 + 354
			elseif e == 3 then
				return 43, 8192 + 476, 2048 + 354
			end
			return 3, 3072 + 496, 8192 + 578
		end

		-- Chests (special_item_group.arezzo.txt) and the panel's flags for every player of the
		-- killer's party inside this instance (get_member_pids gives the members on the killer's
		-- map index), or for the killer alone; a full bag drops them at the player's feet.
		function reward()
			local c = biblioteka_wiedzy.cfg()
			local took = get_global_time() - d.getf("start")
			local pids = {}
			if party.is_party() then
				pids = {party.get_member_pids()}
			end
			if table.getn(pids) == 0 then
				pids = {pc.get_player_id()}
			end
			for i, pid in next, pids, nil do
				q.begin_other_pc_block(pid)
				if not pc.is_playerbot() then
					local n = number(c.chests_min, c.chests_max)
					pc.give_item2(30773, n)
					syschat("Biblioteka Wiedzy: otrzymujesz Skrzynie Biblioteki: "..n..".")
					pc.setf("biblioteka_wiedzy", "finish", pc.getf("biblioteka_wiedzy", "finish") + 1)
					pc.setf("biblioteka_wiedzy", "last_time", took)
					local best = pc.getf("biblioteka_wiedzy", "best_time")
					if best == 0 or took < best then
						pc.setf("biblioteka_wiedzy", "best_time", took)
					end
				end
				q.end_other_pc_block()
			end
			return took
		end

		-- The guard in Orc Valley.
		when 20430.chat."Biblioteka Wiedzy" with pc.get_map_index() ~= 363 and not biblioteka_wiedzy.inside() begin
			local c = biblioteka_wiedzy.cfg()
			say_title(mob_name(20430))
			if pc.is_playerbot() then
				return
			end
			say("Za tym przejœciem le¿y Biblioteka Wiedzy. Paj¹ki")
			say("Baronówny zagnieŸdzi³y siê miêdzy rega³ami i nikt")
			say("nie mo¿e dostaæ siê do ksi¹g.")
			say("")
			say_reward("Wymagany poziom: "..c.min_level..". Limit "..c.limit_min.." minut, ponowne wejœcie po "..math.floor(c.cooldown / 60).." minutach.")
			say_reward("Loch jest tylko dla graczy - boty z dru¿yny zostaj¹ tutaj.")
			say_reward("Wejœcie: "..c.fee_text.." Yang. Najwy¿ej "..c.daily.." wypraw dziennie (dziœ: "..biblioteka_wiedzy.runs_today().."/"..c.daily..").") -- MT2009_PLUS_DUNGEON_FEE_V1
			if select("WejdŸ do Biblioteki Wiedzy", "Nie teraz") ~= 1 then
				return
			end
			-- "/eventflag mt2009_arezzo_closed 1" closes the Arezzo dungeons to players; a GM may always enter.
			if not pc.is_gm() and game.get_event_flag("mt2009_arezzo_closed") > 0 then
				say_title(mob_name(20430))
				say("Przejœcie jest jeszcze zamkniête. Wróæ póŸniej.")
				return
			end
			local now = get_global_time()
			local x, y = biblioteka_wiedzy.entry_xy()
			-- MT2009_PLUS_DUNGEON_END_V1: a run that ended while the player was out is no longer his.
			if biblioteka_wiedzy.clear_stale() then
				say_title(mob_name(20430))
				say("Ten loch zosta³ ju¿ ukoñczony.")
			end
			local idx = pc.getf("biblioteka_wiedzy", "idx")
			if idx > 0 and now - pc.getf("biblioteka_wiedzy", "entry") < c.limit_min * 60 then
				say_title(mob_name(20430))
				say("Twoja wyprawa wci¹¿ trwa. Czy chcesz do niej wróciæ?")
				local s
				if pc.is_gm() then
					s = select("Wróæ do lochu", "Nowa wyprawa (GM)", "Nie teraz")
				else
					s = select("Wróæ do lochu", "Nie teraz")
					if s == 2 then s = 3 end
				end
				if s == 3 then
					return
				elseif s == 1 then
					-- MT2009_PLUS_DUNGEON_END_V1: the login inside knows this jump (no second fee).
					pc.setf("biblioteka_wiedzy", "back", idx)
					pc.setf("biblioteka_wiedzy", "back_at", now)
					if d.find(idx, x, y, pc.get_player_id()) then
						pc.warp(x, y, idx)
					else
						say_title(mob_name(20430))
						say("Jeœli wyprawa wci¹¿ trwa, przejœcie zaraz ciê zabierze.")
						timer("biblioteka_rejoin", 5)
					end
					return
				end
			end
			if party.is_party() and not party.is_leader() then
				say_title(mob_name(20430))
				say("Tylko przywódca dru¿yny mo¿e otworzyæ przejœcie.")
				say("Stañ przy mnie - przywódca zabierze dru¿ynê stoj¹c¹ obok.")
				return
			end
			if pc.get_level() < c.min_level then
				say_title(mob_name(20430))
				say("Jesteœ za s³aby. Wróæ, gdy osi¹gniesz poziom "..c.min_level..".")
				return
			end
			if not pc.can_warp() or pc.is_busy() then
				say_title(mob_name(20430))
				say("Poczekaj chwilê po handlu lub rozmowie i spróbuj ponownie.")
				return
			end
			if now - pc.getf("biblioteka_wiedzy", "pending") < 10 then
				say_title(mob_name(20430))
				say("Przejœcie ju¿ siê otwiera. Poczekaj chwilê.")
				return
			end
			local me = pc.get_player_id()
			local humans = {me}
			local low = {}
			local wait = {}
			local full = {} -- MT2009_PLUS_DUNGEON_FEE_V1
			local poor = {}
			if not pc.is_gm() and now - pc.getf("biblioteka_wiedzy", "entry") < c.cooldown then
				table.insert(wait, pc.get_name())
			end
			if biblioteka_wiedzy.over_limit() then table.insert(full, pc.get_name()) end
			if biblioteka_wiedzy.too_poor() then table.insert(poor, pc.get_name()) end
			if party.is_party() then
				local lmap, lx, ly = pc.get_map_index(), pc.get_x(), pc.get_y()
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					if pid ~= me then
						q.begin_other_pc_block(pid)
						local dx, dy = pc.get_x() - lx, pc.get_y() - ly
						if not pc.is_playerbot() and pc.get_map_index() == lmap and dx * dx + dy * dy <= c.near * c.near and pc.can_warp() then
							table.insert(humans, pid)
							if pc.get_level() < c.min_level then
								table.insert(low, pc.get_name())
							end
							if not pc.is_gm() and now - pc.getf("biblioteka_wiedzy", "entry") < c.cooldown then
								table.insert(wait, pc.get_name())
							end
							if biblioteka_wiedzy.over_limit() then table.insert(full, pc.get_name()) end
							if biblioteka_wiedzy.too_poor() then table.insert(poor, pc.get_name()) end
						end
						q.end_other_pc_block()
					end
				end
			end
			if table.getn(low) > 0 then
				say_title(mob_name(20430))
				say("Za s³abi, by wejœæ (poziom "..c.min_level.."+):")
				for i, n in next, low, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(full) > 0 then
				say("Dzisiejsze wyprawy do tego lochu ju¿ wykorzystane ("..c.daily.." dziennie):")
				for i, n in next, full, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(poor) > 0 then
				say("Wejœcie kosztuje "..c.fee_text.." Yang - za ma³o przy sobie:")
				for i, n in next, poor, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(wait) > 0 then
				say_title(mob_name(20430))
				say("Jeszcze nie odpoczêli po poprzedniej wyprawie:")
				for i, n in next, wait, nil do say(color(1,1,0).."    "..n) end
				local left = c.cooldown - (now - pc.getf("biblioteka_wiedzy", "entry"))
				if left > 0 then
					say("")
					say("Ty mo¿esz wejœæ za "..math.ceil(left / 60).." min.")
				end
				return
			end
			local r = d.new_jump_pids(c.map, x, y, humans)
			if r < 0 then
				biblioteka_wiedzy.lobby()
				return
			end
			pc.setf("biblioteka_wiedzy", "pending", now)
			if r == 0 then
				timer("biblioteka_fallback", 5)
			end
		end

		-- Fallback (as Razador's): the public copy of 363 on game2 is the lobby; the guard there
		-- (or, for a player alone, the lobby's login timer) makes the instance.
		function lobby()
			local c = biblioteka_wiedzy.cfg()
			local x, y = biblioteka_wiedzy.entry_xy()
			if party.is_party() then
				local me = pc.get_player_id()
				local lmap, lx, ly = pc.get_map_index(), pc.get_x(), pc.get_y()
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					if pid ~= me then
						q.begin_other_pc_block(pid)
						local dx, dy = pc.get_x() - lx, pc.get_y() - ly
						if not pc.is_playerbot() and pc.get_map_index() == lmap and dx * dx + dy * dy <= c.near * c.near and pc.can_warp() then
							pc.warp(x, y)
						end
						q.end_other_pc_block()
					end
				end
			else
				pc.setf("biblioteka_wiedzy", "auto", 1)
			end
			pc.setf("biblioteka_wiedzy", "pending", 0)
			pc.warp(x, y)
		end

		when biblioteka_fallback.timer begin
			local c = biblioteka_wiedzy.cfg()
			if pc.get_map_index() == c.map or biblioteka_wiedzy.inside() or pc.getf("biblioteka_wiedzy", "pending") == 0 then
				return
			end
			syschat("Biblioteka Wiedzy: przejœcie prowadzi przez poczekalniê.")
			biblioteka_wiedzy.lobby()
		end

		function lobby_create(humans)
			local c = biblioteka_wiedzy.cfg()
			local x, y = biblioteka_wiedzy.entry_xy()
			local list = {pc.get_player_id()}
			for i, pid in next, humans, nil do
				if pid ~= list[1] then
					table.insert(list, pid)
				end
			end
			return d.new_jump_pids(c.map, x, y, list) > 0
		end

		when 20430.chat."Otwórz Bibliotekê Wiedzy" with pc.get_map_index() == 363 begin
			local c = biblioteka_wiedzy.cfg()
			say_title(mob_name(20430))
			local now = get_global_time()
			-- MT2009_PLUS_DUNGEON_END_V1: an ended run is no longer the player's; the lobby stands on the
			-- instances' own core, so d.find here also tells an instance that is gone.
			if biblioteka_wiedzy.clear_stale() then
				say("Ten loch zosta³ ju¿ ukoñczony.")
			end
			local idx = pc.getf("biblioteka_wiedzy", "idx")
			if idx > 0 and now - pc.getf("biblioteka_wiedzy", "entry") < c.limit_min * 60 then
				if d.find(idx) then
					say("Twoja wyprawa wci¹¿ trwa. Czy chcesz do niej wróciæ?")
					if select("Wróæ do lochu", "Nie teraz") == 1 then
						local x, y = biblioteka_wiedzy.entry_xy()
						pc.warp(x, y, idx)
					end
					return
				end
				pc.setf("biblioteka_wiedzy", "idx", 0)
			end
			if party.is_party() and not party.is_leader() then
				say("Tylko przywódca dru¿yny mo¿e otworzyæ przejœcie.")
				say("Poczekaj tu na niego - zabierze ca³¹ dru¿ynê.")
				return
			end
			local humans = {}
			local low = {}
			local wait = {}
			local full = {} -- MT2009_PLUS_DUNGEON_FEE_V1
			local poor = {}
			if party.is_party() then
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					q.begin_other_pc_block(pid)
					if not pc.is_playerbot() then
						table.insert(humans, pid)
						if pc.get_level() < c.min_level then
							table.insert(low, pc.get_name())
						end
						if not pc.is_gm() and now - pc.getf("biblioteka_wiedzy", "entry") < c.cooldown then
							table.insert(wait, pc.get_name())
						end
						if biblioteka_wiedzy.over_limit() then table.insert(full, pc.get_name()) end
						if biblioteka_wiedzy.too_poor() then table.insert(poor, pc.get_name()) end
					end
					q.end_other_pc_block()
				end
			else
				table.insert(humans, pc.get_player_id())
				if pc.get_level() < c.min_level then
					table.insert(low, pc.get_name())
				end
				if not pc.is_gm() and now - pc.getf("biblioteka_wiedzy", "entry") < c.cooldown then
					table.insert(wait, pc.get_name())
				end
				if biblioteka_wiedzy.over_limit() then table.insert(full, pc.get_name()) end
				if biblioteka_wiedzy.too_poor() then table.insert(poor, pc.get_name()) end
			end
			if table.getn(low) > 0 then
				say("Za s³abi, by wejœæ (poziom "..c.min_level.."+):")
				for i, n in next, low, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(full) > 0 then
				say("Dzisiejsze wyprawy do tego lochu ju¿ wykorzystane ("..c.daily.." dziennie):")
				for i, n in next, full, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(poor) > 0 then
				say("Wejœcie kosztuje "..c.fee_text.." Yang - za ma³o przy sobie:")
				for i, n in next, poor, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(wait) > 0 then
				say("Jeszcze nie odpoczêli po poprzedniej wyprawie:")
				for i, n in next, wait, nil do say(color(1,1,0).."    "..n) end
				return
			end
			say("Dru¿yna na tej mapie wejdzie razem z tob¹.")
			if select("Otwórz przejœcie", "Nie teraz") ~= 1 then
				return
			end
			if not biblioteka_wiedzy.lobby_create(humans) then
				say_title(mob_name(20430))
				say("Nie uda³o siê otworzyæ przejœcia. Spróbuj ponownie za chwilê.")
			end
		end

		when biblioteka_auto.timer begin
			local c = biblioteka_wiedzy.cfg()
			if pc.get_map_index() ~= c.map or party.is_party() then
				return
			end
			local now = get_global_time()
			if pc.get_level() < c.min_level or (not pc.is_gm() and now - pc.getf("biblioteka_wiedzy", "entry") < c.cooldown) then
				syschat("Biblioteka Wiedzy: porozmawiaj ze Stra¿nikiem Biblioteki, aby otworzyæ przejœcie.")
				return
			end
			if not biblioteka_wiedzy.lobby_create({pc.get_player_id()}) then
				syschat("Biblioteka Wiedzy: nie uda³o siê otworzyæ przejœcia - porozmawiaj ze Stra¿nikiem Biblioteki.")
			end
		end

		-- MT2009_PLUS_DUNGEON_END_V1: "Wróæ do lochu" went to another core (d.find) and nobody took the
		-- player there within 5 seconds: the instance is gone, and so is the rejoin state.
		when biblioteka_rejoin.timer begin
			if biblioteka_wiedzy.inside() or pc.getf("biblioteka_wiedzy", "idx") <= 0 then
				return
			end
			pc.setf("biblioteka_wiedzy", "idx", 0)
			syschat("Biblioteka Wiedzy: Ta wyprawa ju¿ siê zakoñczy³a. Porozmawiaj ze stra¿nikiem, aby wyruszyæ na now¹.")
		end

		when login begin
			local c = biblioteka_wiedzy.cfg()
			local idx = pc.get_map_index()
			if idx == c.map then
				-- the lobby (fallback only)
				if pc.is_playerbot() then
					pc.warp(c.exit_x * 100, c.exit_y * 100)
					return
				end
				local em, ex, ey = biblioteka_wiedzy.exit_xy()
				pc.set_warp_location(em, ex, ey)
				pc.setf("biblioteka_wiedzy", "pending", 0)
				if pc.getf("biblioteka_wiedzy", "auto") == 1 and not party.is_party() then
					pc.setf("biblioteka_wiedzy", "auto", 0)
					syschat("Biblioteka Wiedzy: przejœcie siê otwiera...")
					timer("biblioteka_auto", 1)
				else
					pc.setf("biblioteka_wiedzy", "auto", 0)
					syschat("Biblioteka Wiedzy: porozmawiaj ze Stra¿nikiem Biblioteki, aby otworzyæ przejœcie.")
				end
			elseif biblioteka_wiedzy.inside() then
				if pc.is_playerbot() then
					pc.warp(c.exit_x * 100, c.exit_y * 100)
					return
				end
				local em, ex, ey = biblioteka_wiedzy.exit_xy()
				pc.set_warp_location(em, ex, ey)
				pc.setf("biblioteka_wiedzy", "inside", 1)
				pc.setf("biblioteka_wiedzy", "pending", 0)
				-- MT2009_PLUS_DUNGEON_END_V1: an instance whose last boss is down (or whose time is up) takes
				-- nobody back in, and costs nothing.
				if d.getf("ended") == 1 or d.getf("closed") == 1 then
					if pc.getf("biblioteka_wiedzy", "idx") == idx then
						pc.setf("biblioteka_wiedzy", "idx", 0)
					end
					syschat("Biblioteka Wiedzy: Ten loch zosta³ ju¿ ukoñczony.")
					pc.warp(ex * 100, ey * 100)
					return
				end
				-- the guard's "Wróæ do lochu" (its 5-second check may have cleared the state while the jump ran)
				local back = pc.getf("biblioteka_wiedzy", "back") == idx and get_global_time() - pc.getf("biblioteka_wiedzy", "back_at") < 60
				pc.setf("biblioteka_wiedzy", "back", 0)
				if pc.getf("biblioteka_wiedzy", "idx") ~= idx then
					if back then
						pc.setf("biblioteka_wiedzy", "idx", idx)
					else
						if not biblioteka_wiedzy.pay_entry() then -- MT2009_PLUS_DUNGEON_FEE_V1
							pc.warp(ex * 100, ey * 100)
							return
						end
						pc.setf("biblioteka_wiedzy", "idx", idx)
						pc.setf("biblioteka_wiedzy", "entry", get_global_time())
					end
				end
				if d.getf("init") == 0 then
					biblioteka_wiedzy.init()
				end
			else
				if pc.getf("biblioteka_wiedzy", "inside") == 1 then
					pc.setf("biblioteka_wiedzy", "inside", 0)
					if pc.count_item(30765) > 0 then pc.remove_item(30765, pc.count_item(30765)) end
				end
				-- MT2009_PLUS_DUNGEON_END_V1: the run ended while the player was out of it (or its time is up).
				if not pc.is_playerbot() and biblioteka_wiedzy.clear_stale() then
					syschat("Biblioteka Wiedzy: Ten loch zosta³ ju¿ ukoñczony.")
				end
			end
		end

		when biblioteka_stage.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("closed") == 1 then
					return
				end
				local s = d.getf("stage")
				if s >= 10 then
					biblioteka_wiedzy.start_stage(s - 9)
				end
			end
		end

		when biblioteka_tick.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("closed") == 1 then
					return
				end
				local left = d.getf("minutes") - 1
				d.setf("minutes", left)
				if left <= 0 then
					d.notice("Biblioteka Wiedzy: Czas min¹³. Stra¿nik wyprowadza was z Biblioteki.")
					biblioteka_wiedzy.finish()
					return
				end
				-- a seal nobody used within 3 minutes (its holder left, the bag was full...) breaks by itself
				if d.getf("stage") == 1 and d.getf("seal_out") == 1 and get_global_time() - d.getf("seal_time") > 180 then
					d.notice("Biblioteka Wiedzy: Pieczêæ Biblioteki zadzia³a³a sama.")
					biblioteka_wiedzy.seal_used()
				end
				if left == 15 or left == 10 or left == 5 or left == 1 then
					d.notice("Biblioteka Wiedzy: Pozosta³o "..left.." min.")
				end
				server_timer("biblioteka_tick", 60, get_server_timer_arg())
			end
		end

		-- MT2009_PLUS_DUNGEON_END_V1: the countdown after the last boss (end_count), a second at a time.
		when biblioteka_end.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("closed") == 1 then
					return
				end
				biblioteka_wiedzy.end_count(d.getf("end_in"))
			end
		end

		-- Stage 1: the waves and the seals.
		when 9703.kill with biblioteka_wiedzy.inside() and d.getf("stage") == 1 and d.getf("seal_out") == 0 begin
			local c = biblioteka_wiedzy.cfg()
			local k = d.getf("kills") + 1
			d.setf("kills", k)
			if k >= c.wave_kills then
				d.setf("seal_out", 1)
				d.clear_regen()
				biblioteka_wiedzy.purge_mobs()
				d.setf("seal_time", get_global_time())
				pc.give_item2(30765, 1)
				d.notice("Biblioteka Wiedzy: "..pc.get_name().." zdobywa Pieczêæ Biblioteki. U¿yj jej, aby przyzwaæ nastêpn¹ falê.")
			elseif math.mod(k, 20) == 0 then
				d.notice("Biblioteka Wiedzy: Pokonane paj¹ki: "..k.." / "..c.wave_kills)
			end
		end

		when 30765.use begin
			local c = biblioteka_wiedzy.cfg()
			if not biblioteka_wiedzy.inside() or d.getf("stage") ~= 1 or d.getf("seal_out") ~= 1 then
				syschat("Pieczêci Biblioteki mo¿na u¿yæ tylko w Bibliotece Wiedzy, po pokonaniu fali paj¹ków.")
				return
			end
			pc.remove_item(30765, 1)
			biblioteka_wiedzy.seal_used()
		end

		-- Stages 2-5. Stages 2 and 4 are Metins, as in Arezzo (8006, a stone every client shows).
		when 8006.kill with biblioteka_wiedzy.inside() and (d.getf("stage") == 2 or d.getf("stage") == 4) begin
			local left = d.getf("left") - 1
			d.setf("left", left)
			if left <= 0 then
				biblioteka_wiedzy.next_stage()
			else
				d.notice("Biblioteka Wiedzy: Pozosta³e Metiny: "..left)
			end
		end

		when 9705.kill with biblioteka_wiedzy.inside() and d.getf("stage") == 3 begin
			local left = d.getf("left") - 1
			d.setf("left", left)
			if left <= 0 then
				biblioteka_wiedzy.next_stage()
			else
				d.notice("Biblioteka Wiedzy: Pozosta³e królowe: "..left)
			end
		end

		when 9706.kill with biblioteka_wiedzy.inside() and d.getf("stage") == 5 begin
			d.setf("stage", 6)
			d.clear_regen()
			biblioteka_wiedzy.purge_mobs()
			local took = biblioteka_wiedzy.reward()
			d.update_ranking("biblioteka", took) -- MT2009_PLUS_DUNGEON_PANEL_V1: the dungeon panel's results
			-- MT2009_PLUS_DUNGEON_END_V1: the run is over for everyone in it (no "Wróæ do lochu" any more),
			-- and five seconds later everyone is out (was a minute).
			biblioteka_wiedzy.mark_ended()
			d.notice(string.format("Baronówna Paj¹ków pokonana w %d:%02d! Loch zosta³ ukoñczony.", math.floor(took / 60), math.mod(took, 60)))
			biblioteka_wiedzy.end_count(5)
		end
	end
end
