-- MT2009_PLUS_DUNGEONS_V1 (nemere): Lodowa Kraina - loch Nemere, od poziomu 75,
-- tylko dla graczy. Przebieg jak w archiwum "Flame-and-Nemere-dungeon" (R4kan,
-- Nemere.cpp), napisany na lochach silnika (d.*) zamiast osobnego kodu C++:
-- stra¿nik Lodowej Krainy (20395, Góra Sohan, mapa 61) tworzy instancjê mapy 352
-- (metin2_map_n_snow_dungeon_01, rdzeñ game2, d.new_jump_pids przez P2P) i od razu
-- przenosi do niej gracza albo przywódcê z ludŸmi jego dru¿yny stoj¹cymi obok
-- (jedno ³adowanie, bez poczekalni; boty zostaj¹ na zewn¹trz). Kamienny lew (20397)
-- przy wejœciu zaczyna wyprawê:
--   1: zabij 20 potworów,
--   2: potwory upuszczaj¹ Lodowy Klucz (30760, 2%), u¿yj go,
--   3: zabij 20 potworów,
--   4: zabij 20 potworów,
--   5: potwory upuszczaj¹ Kryszta³ Lodu (30761, 4%), oddaj po jednym piêciu pieczêciom (20398),
--   6: zniszcz Metin Mrozu (8058),
--   7: pokonaj czterech Szelów (6151),
--   8: potwory upuszczaj¹ Klucz Mrozu (30762, 2%), u¿yj go,
--   9: zniszcz Lodowy Filar (20399),
--  10: Nemere (6191, sam daje tylko yang); po jego œmierci ka¿dy gracz w lochu
--      dostaje 2-5 Skrzyñ Nemere, a wszyscy wychodz¹ po 60 sekundach.
-- Ka¿dy etap przenosi dru¿ynê do nastêpnej komnaty (5 s, jak w archiwum).
-- Limit 60 minut (archiwum: 3600 s), ponowne wejœcie po godzinie od wejœcia.
quest nemere_dungeon begin
	state start begin
		function cfg()
			return {
				map = 352,
				base_x = 5120, base_y = 1536, size_x = 1024, size_y = 768,
				entry = {171, 270},
				lion = {172, 261},
				exit_map = 61, exit_x = 3584 + 738, exit_y = 1536 + 119,
				min_level = 75,
				near = 30, -- MT2009_PLUS_DUNGEON_ONE_WARP_V1: party members within 30 cells of the leader go with him
				cooldown = 60 * 60,
				limit_min = 60,
				-- MT2009_PLUS_DUNGEON_FEE_V1: the price of a new expedition (each player, paid on entering it) and
				-- how many new expeditions a player may start a day (Polish midnight).
				fee = 15000000, fee_text = "15 000 000",
				daily = 5,
				-- [4] i [5]: 3 komorki na polnoc od pozycji z archiwum - tam server_attr z attr.atr klienta GF (2.0.28) ma sciane.
				rooms = {
					[2] = {422, 261}, [3] = {764, 264}, [4] = {175, 532}, [5] = {421, 535},
					[6] = {748, 540}, [7] = {305, 708}, [8] = {571, 701}, [9] = {851, 693},
					[10] = {927, 395},
				},
				seals = {{449,488},{455,445},{419,422},{382,444},{389,488}},
				metin6 = {747, 494},
				szel = {{302,678},{281,657},{303,635},{324,656}},
				pillar = {849, 660},
				boss = {927, 333},
				path = "data/dungeon/nemere_mt/",
				-- MT2009_PLUS_DUNGEON_DROP_V1: the quest items per mille of a kill (the
				-- owner, 29 September: at 49% one group gave ten crystals). A room holds
				-- 50-60 monsters (10-12 groups of 4-5, back after 60 s): a key ~50 kills,
				-- the five crystals ~125 kills, two to three rooms.
				key_permille = 20,
				crystal_permille = 40,
				chests_min = 2, chests_max = 5,
			}
		end

		-- MT2009_PLUS_DUNGEON_FEE_V1: the entry fee and the daily limit. Checked for everyone at the guard (with
		-- the level and the rest), paid on the first login into a new instance (every way in:
		-- the guard, the lobby, the lobby's own timer) - no money or no runs left there sends
		-- the player out. "Wróæ do lochu" into the same instance costs nothing. GMs are free.
		function today()
			return math.floor((get_global_time() + 7200) / 86400)
		end

		function runs_today()
			if pc.getf("nemere_dungeon", "day") ~= nemere_dungeon.today() then
				return 0
			end
			return pc.getf("nemere_dungeon", "runs")
		end

		function over_limit()
			local c = nemere_dungeon.cfg()
			return not pc.is_gm() and nemere_dungeon.runs_today() >= c.daily
		end

		function too_poor()
			local c = nemere_dungeon.cfg()
			return not pc.is_gm() and pc.get_money() < c.fee
		end

		function pay_entry()
			local c = nemere_dungeon.cfg()
			if pc.is_gm() or pc.is_playerbot() then
				return true
			end
			if nemere_dungeon.over_limit() then
				syschat("Wykorzysta³eœ ju¿ dzisiejsze wyprawy do tego lochu ("..c.daily.."). Wróæ jutro.")
				return false
			end
			if pc.get_money() < c.fee then
				syschat("Wejœcie kosztuje "..c.fee_text.." Yang - nie masz tyle przy sobie.")
				return false
			end
			pc.change_money(-c.fee)
			local day = nemere_dungeon.today()
			if pc.getf("nemere_dungeon", "day") ~= day then
				pc.setf("nemere_dungeon", "day", day)
				pc.setf("nemere_dungeon", "runs", 0)
			end
			pc.setf("nemere_dungeon", "runs", pc.getf("nemere_dungeon", "runs") + 1)
			syschat("Op³ata za wejœcie: "..c.fee_text.." Yang. Dzisiejsza wyprawa "..pc.getf("nemere_dungeon", "runs").."/"..c.daily..".")
			return true
		end

		function inside()
			local idx = pc.get_map_index()
			return idx >= 352 * 10000 and idx < 353 * 10000
		end

		-- MT2009_PLUS_BOSS_CHESTS_V1: the boss's chests (50271, special_item_group.dungeons.txt)
		-- for every player of the killer's party inside this instance (get_member_pids gives
		-- only the members on the killer's map index), or for the killer alone; a full bag
		-- drops them at the player's feet (give_item2). Bots never enter the dungeon.
		-- MT2009_PLUS_DUNGEON_DROP_V1: each player rolls his own 2-5 (the owner, 29 September);
		-- Nemere himself drops only yang (item_manager.cpp).
		-- MT2009_PLUS_DROP_EDIT_V1: the boss's own drop the owner added in the drop workbook
		-- (1 October). The boss gives no items (item_manager.cpp), so the quest rolls it once
		-- per kill for the killer: {vnum, count, percent}, each line on its own.
		function boss_drop()
			if pc.is_playerbot() then return end
			-- MT2009_PLUS_AWAKENING_V1: no Kamien Przebudzenia here (the owner, 3 October).
			local t = { {27987, 5, 10}, {50513, 1, 5}, {50255, 15, 5}, {25040, 3, 10}, {71084, 2, 10}, {71085, 1, 10}, {72067, 1, 70} }
			for i, e in next, t, nil do
				if number(1, 100) <= e[3] then
					pc.give_item2(e[1], e[2])
				end
			end
		end

		function give_chests()
			local c = nemere_dungeon.cfg()
			nemere_dungeon.boss_drop()
			local pids = {}
			if party.is_party() then
				pids = {party.get_member_pids()}
			end
			if table.getn(pids) == 0 then
				pids = {pc.get_player_id()}
			end
			for i, pid in next, pids, nil do
				q.begin_other_pc_block(pid)
				if not pc.is_playerbot() then
					local n = number(c.chests_min, c.chests_max)
					for k = 1, n do
						pc.give_item2(50271, 1)
					end
					syschat("Nemere: otrzymujesz Skrzynie Nemere: "..n..".")
				end
				q.end_other_pc_block()
			end
		end

		function purge_mobs()
			local c = nemere_dungeon.cfg()
			d.purge_area(c.base_x * 100, c.base_y * 100, (c.base_x + c.size_x) * 100, (c.base_y + c.size_y) * 100)
		end

		function step_text(step)
			if step == 1 or step == 3 or step == 4 then return "Zabij 20 potworów."
			elseif step == 2 then return "Zdob¹dŸ Lodowy Klucz z potworów i u¿yj go."
			elseif step == 5 then return "Zdob¹dŸ Kryszta³y Lodu z potworów i oddaj po jednym ka¿dej z piêciu pieczêci."
			elseif step == 6 then return "Zniszcz Metin Mrozu."
			elseif step == 7 then return "Pokonaj czterech Szelów."
			elseif step == 8 then return "Zdob¹dŸ Klucz Mrozu z potworów i u¿yj go."
			elseif step == 9 then return "Zniszcz Lodowy Filar."
			end
			return "Pokonaj Nemere!"
		end

		-- Next stage: clean the room, then after 5 s the next room (timer).
		function go(step)
			d.clear_regen()
			nemere_dungeon.purge_mobs()
			d.setf("step", step)
			d.setf("kills", 0)
			d.setf("ready", 0)
			d.notice("Nemere: Etap zaliczony. Za 5 sekund przejdziecie dalej.")
			server_timer("nemere_step", 5, d.get_map_index())
		end

		function finish()
			local c = nemere_dungeon.cfg()
			d.setf("closed", 1)
			d.setf("mt2009_keep_until", 0)
			d.set_warp_location(c.exit_map, c.exit_x, c.exit_y)
			d.exit_all()
		end

		-- MT2009_PLUS_DUNGEON_ONE_WARP_V1: one loading screen (the owner, 29 September: the guard's
		-- warp to the lobby and then the lobby's warp into the instance were two). The guard
		-- (map 61, game1) asks for a new instance of 352 with d.new_jump_pids: game2, which
		-- hosts 352, makes it and warps the player - or the leader and the people of his party
		-- standing by the guard - straight into it (engine, server-patches/playerqol). The
		-- instance is set up by the first of them to log in (init below), and each player's
		-- cooldown starts when he enters it; bots stay outside.
		function init()
			local c = nemere_dungeon.cfg()
			d.setf("init", 1)
			d.setf("entered", 1)
			-- MT2009_PLUS_DUNGEON_RETURN_V1: the instance outlives its players until the time limit
			-- (dungeon.cpp), so "Wróæ do lochu" at the guard finds it after a disconnect.
			d.setf("mt2009_keep_until", get_global_time() + c.limit_min * 60 + 60)
			d.setf("step", 0)
			d.setf("left", c.limit_min)
			d.spawn_mob(20397, c.lion[1], c.lion[2])
			server_timer("nemere_tick", 60, d.get_map_index())
		end

		function entry_xy()
			local c = nemere_dungeon.cfg()
			return (c.base_x + c.entry[1]) * 100, (c.base_y + c.entry[2]) * 100
		end

		when 20395.chat."Lodowa Kraina (Nemere)" begin
			local c = nemere_dungeon.cfg()
			say_title(mob_name(20395))
			if pc.is_playerbot() then
				return
			end
			say("Za tym przejœciem le¿y Lodowa Kraina, w której")
			say("czeka Nemere, pan mrozu. Nikt stamt¹d nie wróci³,")
			say("by o nim opowiedzieæ.")
			say("")
			say_reward("Wymagany poziom: "..c.min_level..". Ponowne wejœcie po 60 minutach.")
			say_reward("Loch jest tylko dla graczy - boty z dru¿yny zostaj¹ tutaj.")
			say_reward("Wejœcie: "..c.fee_text.." Yang. Najwy¿ej "..c.daily.." wypraw dziennie (dziœ: "..nemere_dungeon.runs_today().."/"..c.daily..").") -- MT2009_PLUS_DUNGEON_FEE_V1
			if select("PrzejdŸ do Lodowej Krainy", "Nie teraz") ~= 1 then
				return
			end
			-- Open since client 2.0.28 carries the maps; "/eventflag mt2009_dungeons_closed 1"
			-- closes both dungeons to players; a GM may always enter.
			if not pc.is_gm() and game.get_event_flag("mt2009_dungeons_closed") > 0 then
				say_title(mob_name(20395))
				say("Przejœcie jest jeszcze zamkniête. Wróæ póŸniej.")
				return
			end
			local now = get_global_time()
			local x, y = nemere_dungeon.entry_xy()
			-- An expedition still running: back into it. d.find asks game2, which warps the
			-- player if the instance is still there (the cooldown equals the time limit).
			local idx = pc.getf("nemere_dungeon", "idx")
			if idx > 0 and now - pc.getf("nemere_dungeon", "entry") < c.limit_min * 60 then
				say_title(mob_name(20395))
				say("Twoja wyprawa wci¹¿ trwa. Czy chcesz do niej wróciæ?")
				local s
				if pc.is_gm() then
					s = select("Wróæ do lochu", "Nowa wyprawa (GM)", "Nie teraz")
				else
					s = select("Wróæ do lochu", "Nie teraz")
					if s == 2 then s = 3 end
				end
				if s == 3 then
					return
				elseif s == 1 then
					if d.find(idx, x, y, pc.get_player_id()) then
						pc.warp(x, y, idx)
					else
						say_title(mob_name(20395))
						say("Jeœli wyprawa wci¹¿ trwa, przejœcie zaraz ciê zabierze.")
					end
					return
				end
			end
			if party.is_party() and not party.is_leader() then
				say_title(mob_name(20395))
				say("Tylko przywódca dru¿yny mo¿e otworzyæ przejœcie.")
				say("Stañ przy mnie - przywódca zabierze dru¿ynê stoj¹c¹ obok.")
				return
			end
			if pc.get_level() < c.min_level then
				say_title(mob_name(20395))
				say("Jesteœ za s³aby. Wróæ, gdy osi¹gniesz poziom "..c.min_level..".")
				return
			end
			if not pc.can_warp() or pc.is_busy() then
				say_title(mob_name(20395))
				say("Poczekaj chwilê po handlu lub rozmowie i spróbuj ponownie.")
				return
			end
			if now - pc.getf("nemere_dungeon", "pending") < 10 then
				say_title(mob_name(20395))
				say("Przejœcie ju¿ siê otwiera. Poczekaj chwilê.")
				return
			end
			-- Who goes: the player, or the leader and the people of his party standing by
			-- the guard (c.near cells); bots stay. Anyone too weak or not yet rested stops it.
			local me = pc.get_player_id()
			local humans = {me}
			local low = {}
			local wait = {}
			local full = {} -- MT2009_PLUS_DUNGEON_FEE_V1
			local poor = {}
			if not pc.is_gm() and now - pc.getf("nemere_dungeon", "entry") < c.cooldown then
				table.insert(wait, pc.get_name())
			end
			if nemere_dungeon.over_limit() then table.insert(full, pc.get_name()) end
			if nemere_dungeon.too_poor() then table.insert(poor, pc.get_name()) end
			if party.is_party() then
				local lmap, lx, ly = pc.get_map_index(), pc.get_x(), pc.get_y()
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					if pid ~= me then
						q.begin_other_pc_block(pid)
						local dx, dy = pc.get_x() - lx, pc.get_y() - ly
						if not pc.is_playerbot() and pc.get_map_index() == lmap and dx * dx + dy * dy <= c.near * c.near and pc.can_warp() then
							table.insert(humans, pid)
							if pc.get_level() < c.min_level then
								table.insert(low, pc.get_name())
							end
							if not pc.is_gm() and now - pc.getf("nemere_dungeon", "entry") < c.cooldown then
								table.insert(wait, pc.get_name())
							end
							if nemere_dungeon.over_limit() then table.insert(full, pc.get_name()) end
							if nemere_dungeon.too_poor() then table.insert(poor, pc.get_name()) end
						end
						q.end_other_pc_block()
					end
				end
			end
			if table.getn(low) > 0 then
				say_title(mob_name(20395))
				say("Za s³abi, by wejœæ (poziom "..c.min_level.."+):")
				for i, n in next, low, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(full) > 0 then
				say("Dzisiejsze wyprawy do tego lochu ju¿ wykorzystane ("..c.daily.." dziennie):")
				for i, n in next, full, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(poor) > 0 then
				say("Wejœcie kosztuje "..c.fee_text.." Yang - za ma³o przy sobie:")
				for i, n in next, poor, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(wait) > 0 then
				say_title(mob_name(20395))
				say("Jeszcze nie odpoczêli po poprzedniej wyprawie:")
				for i, n in next, wait, nil do say(color(1,1,0).."    "..n) end
				local left = c.cooldown - (now - pc.getf("nemere_dungeon", "entry"))
				if left > 0 then
					say("")
					say("Ty mo¿esz wejœæ za "..math.ceil(left / 60).." min.")
				end
				return
			end
			local r = d.new_jump_pids(c.map, x, y, humans)
			if r < 0 then
				-- The request could not be made: the old way, through the lobby.
				nemere_dungeon.lobby()
				return
			end
			pc.setf("nemere_dungeon", "pending", now)
			if r == 0 then
				-- game2 makes the instance; a warp that has not come in 5 s means the request
				-- got lost (game2 down or restarting) - the lobby instead (fallback timer).
				timer("nemere_fallback", 5)
			end
		end

		-- The fallback (the path before MT2009_PLUS_DUNGEON_ONE_WARP_V1): the guard sends the
		-- player, or the leader with the people of his party standing by, to the public copy
		-- of the map on game2 - the lobby - where the statue/lion (or, for a player alone, the
		-- lobby's login timer) makes the instance with d.new_jump_pids, local there.
		function lobby()
			local c = nemere_dungeon.cfg()
			local x, y = nemere_dungeon.entry_xy()
			if party.is_party() then
				local me = pc.get_player_id()
				local lmap, lx, ly = pc.get_map_index(), pc.get_x(), pc.get_y()
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					if pid ~= me then
						q.begin_other_pc_block(pid)
						local dx, dy = pc.get_x() - lx, pc.get_y() - ly
						if not pc.is_playerbot() and pc.get_map_index() == lmap and dx * dx + dy * dy <= c.near * c.near and pc.can_warp() then
							pc.warp(x, y)
						end
						q.end_other_pc_block()
					end
				end
			else
				pc.setf("nemere_dungeon", "auto", 1)
			end
			pc.setf("nemere_dungeon", "pending", 0)
			pc.warp(x, y)
		end

		when nemere_fallback.timer begin
			local c = nemere_dungeon.cfg()
			if pc.get_map_index() ~= c.exit_map or pc.getf("nemere_dungeon", "pending") == 0 then
				return
			end
			syschat("Lodowa Kraina: przejœcie prowadzi przez poczekalniê.")
			nemere_dungeon.lobby()
		end


		function lobby_create(humans)
			local c = nemere_dungeon.cfg()
			local x, y = nemere_dungeon.entry_xy()
			-- the leader first: the engine makes pids[1] the dungeon's "leader"
			local list = {pc.get_player_id()}
			for i, pid in next, humans, nil do
				if pid ~= list[1] then
					table.insert(list, pid)
				end
			end
			return d.new_jump_pids(c.map, x, y, list) > 0
		end

		-- The lobby (public map 352 on game2): the leader, or a player alone, opens the instance.
		when 20397.chat."Otwórz przejœcie do Lodowej Krainy" with pc.get_map_index() == 352 begin
			local c = nemere_dungeon.cfg()
			say_title(mob_name(20397))
			local now = get_global_time()
			local idx = pc.getf("nemere_dungeon", "idx")
			if idx > 0 and now - pc.getf("nemere_dungeon", "entry") < c.limit_min * 60 and d.find(idx) then
				say("Twoja wyprawa wci¹¿ trwa. Czy chcesz do niej wróciæ?")
				if select("Wróæ do lochu", "Nie teraz") == 1 then
					pc.warp((c.base_x + c.entry[1]) * 100, (c.base_y + c.entry[2]) * 100, idx)
				end
				return
			end
			if party.is_party() and not party.is_leader() then
				say("Tylko przywódca dru¿yny mo¿e otworzyæ przejœcie.")
				say("Poczekaj tu na niego - zabierze ca³¹ dru¿ynê.")
				return
			end
			local humans = {}
			local low = {}
			local wait = {}
			local full = {} -- MT2009_PLUS_DUNGEON_FEE_V1
			local poor = {}
			if party.is_party() then
				local pids = {party.get_member_pids()}
				for i, pid in next, pids, nil do
					q.begin_other_pc_block(pid)
					if not pc.is_playerbot() then
						table.insert(humans, pid)
						if pc.get_level() < c.min_level then
							table.insert(low, pc.get_name())
						end
						if not pc.is_gm() and now - pc.getf("nemere_dungeon", "entry") < c.cooldown then
							table.insert(wait, pc.get_name())
						end
						if nemere_dungeon.over_limit() then table.insert(full, pc.get_name()) end
						if nemere_dungeon.too_poor() then table.insert(poor, pc.get_name()) end
					end
					q.end_other_pc_block()
				end
			else
				table.insert(humans, pc.get_player_id())
				if pc.get_level() < c.min_level then
					table.insert(low, pc.get_name())
				end
				if not pc.is_gm() and now - pc.getf("nemere_dungeon", "entry") < c.cooldown then
					table.insert(wait, pc.get_name())
				end
				if nemere_dungeon.over_limit() then table.insert(full, pc.get_name()) end
				if nemere_dungeon.too_poor() then table.insert(poor, pc.get_name()) end
			end
			if table.getn(low) > 0 then
				say("Za s³abi, by wejœæ (poziom "..c.min_level.."+):")
				for i, n in next, low, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(full) > 0 then
				say("Dzisiejsze wyprawy do tego lochu ju¿ wykorzystane ("..c.daily.." dziennie):")
				for i, n in next, full, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(poor) > 0 then
				say("Wejœcie kosztuje "..c.fee_text.." Yang - za ma³o przy sobie:")
				for i, n in next, poor, nil do say(color(1,1,0).."    "..n) end
				return
			end
			if table.getn(wait) > 0 then
				say("Jeszcze nie odpoczêli po poprzedniej wyprawie:")
				for i, n in next, wait, nil do say(color(1,1,0).."    "..n) end
				local left = c.cooldown - (now - pc.getf("nemere_dungeon", "entry"))
				if left > 0 then
					say("")
					say("Ty mo¿esz wejœæ za "..math.ceil(left / 60).." min.")
				end
				return
			end
			say("Dru¿yna na tej mapie wejdzie razem z tob¹.")
			if select("Otwórz przejœcie", "Nie teraz") ~= 1 then
				return
			end
			if not nemere_dungeon.lobby_create(humans) then
				say_title(mob_name(20397))
				say("Nie uda³o siê otworzyæ przejœcia. Spróbuj ponownie za chwilê.")
			end
		end

		-- A player alone, sent by the guard, goes into a new instance a second after the lobby
		-- loads - no walk to the lion. Anything that stops it leaves him at the lion.
		when nemere_auto.timer begin
			local c = nemere_dungeon.cfg()
			if pc.get_map_index() ~= c.map or party.is_party() then
				return
			end
			local now = get_global_time()
			if pc.get_level() < c.min_level or (not pc.is_gm() and now - pc.getf("nemere_dungeon", "entry") < c.cooldown) then
				syschat("Lodowa Kraina: porozmawiaj z Kamiennym Lwem, aby otworzyæ przejœcie.")
				return
			end
			if not nemere_dungeon.lobby_create({pc.get_player_id()}) then
				syschat("Lodowa Kraina: nie uda³o siê otworzyæ przejœcia - porozmawiaj z Kamiennym Lwem.")
			end
		end

		when login begin
			local c = nemere_dungeon.cfg()
			local idx = pc.get_map_index()
			if idx == c.map then
				-- The lobby (fallback only).
				if pc.is_playerbot() then
					pc.warp(c.exit_x * 100, c.exit_y * 100)
					return
				end
				pc.set_warp_location(c.exit_map, c.exit_x, c.exit_y)
				pc.setf("nemere_dungeon", "pending", 0)
				if pc.getf("nemere_dungeon", "auto") == 1 and not party.is_party() then
					pc.setf("nemere_dungeon", "auto", 0)
					syschat("Lodowa Kraina: przejœcie siê otwiera...")
					timer("nemere_auto", 1)
				else
					pc.setf("nemere_dungeon", "auto", 0)
					syschat("Lodowa Kraina: porozmawiaj z Kamiennym Lwem, aby otworzyæ przejœcie.")
				end
			elseif nemere_dungeon.inside() then
				if pc.is_playerbot() then
					pc.warp(c.exit_x * 100, c.exit_y * 100)
					return
				end
				pc.set_warp_location(c.exit_map, c.exit_x, c.exit_y)
				pc.setf("nemere_dungeon", "inside", 1)
				pc.setf("nemere_dungeon", "pending", 0)
				if pc.getf("nemere_dungeon", "idx") ~= idx then
					if not nemere_dungeon.pay_entry() then -- MT2009_PLUS_DUNGEON_FEE_V1
						pc.warp(c.exit_x * 100, c.exit_y * 100)
						return
					end
					pc.setf("nemere_dungeon", "idx", idx)
					pc.setf("nemere_dungeon", "entry", get_global_time())
				end
				if d.getf("init") == 0 then
					nemere_dungeon.init()
				end
				if d.getf("closed") == 1 then
					pc.warp(c.exit_x * 100, c.exit_y * 100)
				elseif d.getf("step") == 0 then
					d.notice("Nemere: Porozmawiaj z Kamiennym Lwem, aby rozpocz¹æ wyprawê.")
				end
			elseif pc.getf("nemere_dungeon", "inside") == 1 then
				pc.setf("nemere_dungeon", "inside", 0)
				for v = 30760, 30762 do
					if pc.count_item(v) > 0 then pc.remove_item(v, pc.count_item(v)) end
				end
			end
		end

		when 20397.chat."Rozpocznij wyprawê na Nemere" with nemere_dungeon.inside() and d.getf("step") == 0 begin
			local c = nemere_dungeon.cfg()
			say_title(mob_name(20397))
			if party.is_party() and d.getf("leader") ~= pc.get_player_id() then
				say("Tylko przywódca wyprawy mo¿e obudziæ lwa.")
				return
			end
			say("Lew budzi siê, a z mrozu wychodz¹ potwory...")
			npc.purge()
			d.setf("step", 1)
			d.setf("kills", 0)
			d.setf("ready", 1)
			d.regen_file(c.path.."zone_1.txt")
			d.notice("Nemere: "..nemere_dungeon.step_text(1))
		end

		when nemere_step.server_timer begin
			if d.select(get_server_timer_arg()) then
				local c = nemere_dungeon.cfg()
				local step = d.getf("step")
				local room = c.rooms[step]
				if room then
					d.jump_all(c.base_x + room[1], c.base_y + room[2])
				end
				if step == 2 then
					d.set_regen_file(c.path.."zone_2.txt")
				elseif step == 3 then
					d.regen_file(c.path.."zone_3.txt")
				elseif step == 4 then
					d.regen_file(c.path.."zone_4.txt")
				elseif step == 5 then
					for i = 1, table.getn(c.seals) do
						d.spawn_mob(20398, c.seals[i][1], c.seals[i][2])
					end
					d.setf("seals", table.getn(c.seals))
					d.set_regen_file(c.path.."zone_5.txt")
				elseif step == 6 then
					d.spawn_mob(8058, c.metin6[1], c.metin6[2])
				elseif step == 7 then
					for i = 1, table.getn(c.szel) do
						d.spawn_mob(6151, c.szel[i][1], c.szel[i][2])
					end
				elseif step == 8 then
					d.set_regen_file(c.path.."zone_8.txt")
				elseif step == 9 then
					d.spawn_mob(20399, c.pillar[1], c.pillar[2])
				elseif step == 10 then
					d.spawn_mob(6191, c.boss[1], c.boss[2])
				end
				d.setf("ready", 1)
				d.notice("Nemere: "..nemere_dungeon.step_text(step))
			end
		end

		when nemere_tick.server_timer begin
			if d.select(get_server_timer_arg()) then
				if d.getf("closed") == 1 then
					return
				end
				local left = d.getf("left") - 1
				d.setf("left", left)
				if left <= 0 then
					d.notice("Nemere: Czas min¹³. Mróz wyrzuca was z Lodowej Krainy.")
					nemere_dungeon.finish()
					return
				end
				if left == 30 or left == 15 or left == 10 or left == 5 or left == 1 then
					d.notice("Nemere: Pozosta³o "..left.." min.")
				end
				server_timer("nemere_tick", 60, get_server_timer_arg())
			end
		end

		when nemere_end.server_timer begin
			if d.select(get_server_timer_arg()) then
				nemere_dungeon.finish()
			end
		end

		when kill with nemere_dungeon.inside() and d.getf("ready") == 1 begin
			local c = nemere_dungeon.cfg()
			local step = d.getf("step")
			local race = npc.get_race()
			if race < 6101 or race > 6199 then
				return
			end
			if step == 1 or step == 3 or step == 4 then
				d.setf("kills", d.getf("kills") + 1)
				if d.getf("kills") >= 20 then
					nemere_dungeon.go(step + 1)
				end
			elseif step == 2 then
				if number(1, 1000) <= c.key_permille then
					game.drop_item_with_ownership(30760, 1, 60)
				end
			elseif step == 5 then
				if number(1, 1000) <= c.crystal_permille then
					game.drop_item_with_ownership(30761, 1, 60)
				end
			elseif step == 8 then
				if number(1, 1000) <= c.key_permille then
					game.drop_item_with_ownership(30762, 1, 60)
				end
			end
		end

		when 30760.use with nemere_dungeon.inside() begin
			if d.getf("step") == 2 and d.getf("ready") == 1 then
				pc.remove_item(30760, 1)
				d.notice("Nemere: Lodowy Klucz otworzy³ przejœcie.")
				nemere_dungeon.go(3)
			else
				syschat("Ten klucz nie pasuje teraz do niczego.")
			end
		end

		when 30762.use with nemere_dungeon.inside() begin
			if d.getf("step") == 8 and d.getf("ready") == 1 then
				pc.remove_item(30762, 1)
				d.notice("Nemere: Klucz Mrozu otworzy³ przejœcie.")
				nemere_dungeon.go(9)
			else
				syschat("Ten klucz nie pasuje teraz do niczego.")
			end
		end

		when 20398.take with nemere_dungeon.inside() and d.getf("step") == 5 and d.getf("ready") == 1 begin
			if item.vnum == 30761 then
				item.remove()
				npc.purge()
				d.setf("seals", d.getf("seals") - 1)
				if d.getf("seals") <= 0 then
					nemere_dungeon.go(6)
				else
					d.notice("Nemere: Pieczêæ z³amana. Pozosta³o: "..d.getf("seals"))
				end
			else
				say_title(mob_name(20398))
				say("Pieczêæ przyjmie tylko Kryszta³ Lodu.")
			end
		end

		when 8058.kill with nemere_dungeon.inside() and d.getf("step") == 6 and d.getf("ready") == 1 begin
			nemere_dungeon.go(7)
		end

		when 6151.kill with nemere_dungeon.inside() and d.getf("step") == 7 and d.getf("ready") == 1 begin
			d.setf("kills", d.getf("kills") + 1)
			if d.getf("kills") >= 4 then
				nemere_dungeon.go(8)
			else
				d.notice("Nemere: Szel pokonany ("..d.getf("kills").."/4).")
			end
		end

		when 20399.kill with nemere_dungeon.inside() and d.getf("step") == 9 and d.getf("ready") == 1 begin
			nemere_dungeon.go(10)
		end

		when 6191.kill with nemere_dungeon.inside() and d.getf("step") == 10 and d.getf("ready") == 1 begin
			d.setf("step", 11)
			nemere_dungeon.give_chests()
			d.update_ranking("nemere") -- MT2009_PLUS_DUNGEON_PANEL_V1: the dungeon panel's results
			d.clear_regen()
			nemere_dungeon.purge_mobs()
			d.notice("Nemere zosta³ pokonany! Za 60 sekund wszyscy wróc¹ na Górê Sohan.")
			server_timer("nemere_end", 60, d.get_map_index())
		end
	end
end
