-- The four game masters on the tester account, brought to one profile by
-- the engine itself, once per profile version.
--
-- gm_characters.sql creates the characters a fresh account lacks; it never
-- touches a character that exists, and it cannot set skills, wear gear or
-- fill an elixir. So a world where the operator made Tieru before the four
-- existed had a level-1 shaman with a fan, and the three it did create
-- lost pieces over time with nothing putting them back (the 12 September
-- audit under docs/codex-audits/admin-gm-mt2009-20260912). This quest runs
-- on every login of a GM character on the `admin' account and, when the
-- character's profile version is behind, brings it to the profile through
-- the engine's own paths: pc.set_level, pc.set_skill_level, horse.set_level,
-- pc.give_item2_select + item.set_attr + pc.equip_slot, and item.use for
-- the elixir. Every step first asks what the character already has, so a
-- login cut off half way finishes the rest next time and never doubles a
-- piece; the version flag is written last.
--
-- What it does not do: touch anybody outside the admin account, resize
-- what is already there, take valuable pieces away, or repeat the elixir
-- toggle (that would switch a running elixir off).
quest gm_profile begin
	state start begin
		function profile()
			-- Wear slots: 0 body, 1 head, 2 foots, 3 wrist, 4 weapon, 5 neck,
			-- 6 ear, 10 shield. Bonus lines are POINT numbers on this engine
			-- (item.attrtype is a POINT here, common/length.h): the GM preset
			-- of gm_characters.sql, unchanged.
			local weapon_attrs = {40, 10, 41, 10, 53, 20, 43, 10, 21, 20, 122, 45, 121, 20}
			local body_attrs   = {6, 1500, 63, 10, 95, 50, 21, 20, 77, 15, 0, 0, 0, 0}
			local head_attrs   = {32, 12, 17, 8, 68, 15, 77, 15, 43, 10, 0, 0, 0, 0}
			local foots_attrs  = {6, 1500, 17, 8, 19, 20, 40, 10, 68, 15, 0, 0, 0, 0}
			local wrist_attrs  = {6, 1500, 8, 250, 41, 10, 63, 10, 43, 10, 0, 0, 0, 0}
			local neck_attrs   = {6, 1500, 8, 250, 40, 10, 41, 10, 32, 12, 0, 0, 0, 0}
			local ear_attrs    = {19, 20, 43, 10, 44, 20, 45, 20, 47, 20, 0, 0, 0, 0}
			local shield_attrs = {67, 15, 12, 12, 13, 12, 43, 10, 79, 10, 0, 0, 0, 0}
			local job = pc.get_job()
			local p = {}
			if job == 0 then
				p.weapon = 189; p.body = 11299; p.head = 12289; p.foots = 15379
				p.second = 3169; p.skills = {1, 2, 3, 4, 5}
			elseif job == 1 then
				p.weapon = 1139; p.body = 11499; p.head = 12409; p.foots = 15399
				p.second = 2179; p.arrows = 8009; p.skills = {31, 32, 33, 34, 35}
				p.extra_skill = 140
			elseif job == 2 then
				p.weapon = 199; p.body = 11699; p.head = 12549; p.foots = 15419
				p.second = 0; p.skills = {61, 62, 63, 64, 65, 66}
			else
				p.weapon = 5129; p.body = 11899; p.head = 12689; p.foots = 15439
				p.second = 7189; p.skills = {91, 92, 93, 94, 95, 96}
			end
			p.wrist = 14529; p.neck = 16529; p.ear = 17529; p.shield = 13149
			p.worn = {
				{0, p.body, body_attrs}, {1, p.head, head_attrs}, {2, p.foots, foots_attrs},
				{3, p.wrist, wrist_attrs}, {4, p.weapon, weapon_attrs}, {5, p.neck, neck_attrs},
				{6, p.ear, ear_attrs}, {10, p.shield, shield_attrs},
			}
			p.weapon_attrs = weapon_attrs
			return p
		end

		-- The bag cell holding an item of this vnum, or -1: the two bag pages
		-- walked with select_cell, which selects the item standing in a cell.
		function find_cell(vnum)
			for cell = 0, 89 do
				if item.select_cell(cell) then
					if item.get_vnum() == vnum then
						return cell
					end
				end
			end
			return -1
		end

		-- One piece for one wear slot: given with the preset when the bag has
		-- none, then worn; a piece already in the bag is worn from there.
		-- Whatever else the slot holds comes off for it. Returns 1 when a
		-- piece was given. The engine admits five equips a half second per
		-- player (CanEquipNow's ItemEquip pulse) and a login can spend them
		-- before this runs, so a refusal is marked for the retry timer rather
		-- than trusted.
		function ensure_worn(slot, vnum, attrs)
			local worn = pc.get_wear(slot)
			if worn == vnum then
				return 0
			end
			local cell = gm_profile.find_cell(vnum)
			local given = 0
			if cell < 0 then
				pc.give_item2_select(vnum, 1)
				if item.get_vnum() ~= vnum then
					sys_log(0, "GM_PROFILE: " .. pc.get_name() .. " could not receive " .. vnum)
					return 0
				end
				item.set_attr(attrs)
				cell = item.get_cell()
				given = 1
			end
			if worn ~= nil then
				pc.unequip_slot(slot)
			end
			if not pc.equip_slot(cell) or pc.get_wear(slot) ~= vnum then
				sys_log(0, "GM_PROFILE: " .. pc.get_name() .. " could not wear " .. vnum .. " (slot " .. slot .. ")")
				pc.setqf("wear_retry", 1)
			end
			return given
		end

		-- The worn set again, for what a login refused: run from a timer a
		-- few seconds after login, up to five times a second apart.
		function wear_again()
			local p = gm_profile.profile()
			pc.setqf("wear_retry", 0)
			for i = 1, table.getn(p.worn) do
				gm_profile.ensure_worn(p.worn[i][1], p.worn[i][2], p.worn[i][3])
			end
			return pc.getqf("wear_retry")
		end

		-- A stackable topped up to a count, in stacks the proto allows and
		-- never more than 200 a call. ITEM_COUNT is a DWORD on this engine,
		-- so the thousand arrows would arrive whole; the r40250 line hands
		-- the same count to AutoGiveItem as a BYTE (web_admin.quest's
		-- qty_too_big), and two hundred a call keeps the quest text true on
		-- both.
		function ensure_count(vnum, wanted)
			local have = pc.count_item(vnum)
			if have >= wanted then
				return 0
			end
			local missing = wanted - have
			local stack = item.get_max_stack(vnum)
			if stack == nil or stack < 1 then
				stack = 1
			end
			if stack > 200 then
				stack = 200
			end
			while missing > 0 do
				local n = missing
				if n > stack then
					n = stack
				end
				pc.give_item2(vnum, n)
				missing = missing - n
			end
			return 1
		end

		-- An elixir is created "used up" by this engine's item factory
		-- (socket1, the used capacity, starts at the full capacity); the
		-- port fixes the factory, and this is the belt to those braces.
		function give_elixir(vnum)
			pc.give_item2_select(vnum, 1)
			if item.get_vnum() == vnum then
				item.set_socket(1, 0)
				return 1
			end
			return 0
		end

		function apply()
			local p = gm_profile.profile()
			local name = pc.get_name()
			-- 1. Level, gold, profession. The +9 set needs level 70-90.
			if pc.get_level() < 90 then
				pc.set_level(90)
			end
			if pc.get_money() < 500000000 then
				pc.change_money(500000000 - pc.get_money())
			end
			if pc.get_skill_group() == 0 then
				pc.set_skill_group(1)
			end
			-- 2. Skills: the profession's at P, the shared ones at their own
			-- ceilings (combo 2, languages 20, riding 21 for the level-21
			-- horse, horse summon 10, war-horse skills 20).
			if pc.get_skill_group() == 1 then
				for i = 1, table.getn(p.skills) do
					pc.set_skill_level(p.skills[i], 40)
				end
			end
			pc.set_skill_level(121, 40)
			pc.set_skill_level(122, 2)
			pc.set_skill_level(126, 20)
			pc.set_skill_level(127, 20)
			pc.set_skill_level(128, 20)
			pc.set_skill_level(129, 40)
			pc.set_skill_level(130, 21)
			pc.set_skill_level(131, 10)
			pc.set_skill_level(137, 20)
			pc.set_skill_level(138, 20)
			pc.set_skill_level(139, 20)
			if p.extra_skill ~= nil then
				pc.set_skill_level(p.extra_skill, 20)
			end
			-- 3. The war horse: level 21 (grade 3), stats of the level.
			if horse.get_level() < 21 then
				horse.set_level(21)
			end
			-- 4. Worn set.
			local given = 0
			for i = 1, table.getn(p.worn) do
				given = given + gm_profile.ensure_worn(p.worn[i][1], p.worn[i][2], p.worn[i][3])
			end
			-- 5. The second weapon in the bag, arrows for the bow.
			if p.second ~= nil and p.second ~= 0 and pc.count_item(p.second) == 0 and pc.get_wear(4) ~= p.second then
				pc.give_item2_select(p.second, 1)
				if item.get_vnum() == p.second then
					item.set_attr(p.weapon_attrs)
					given = given + 1
				end
			end
			if p.arrows ~= nil then
				given = given + gm_profile.ensure_count(p.arrows, 1000)
			end
			-- 6. The bag: tools and supplies, each to its minimum, stacks the
			-- proto allows (scrolls stack twenty here, not fifty).
			given = given + gm_profile.ensure_count(50053, 1)
			given = given + gm_profile.ensure_count(27007, 200)
			given = given + gm_profile.ensure_count(27008, 200)
			given = given + gm_profile.ensure_count(50056, 20)
			given = given + gm_profile.ensure_count(50059, 5)
			given = given + gm_profile.ensure_count(25040, 20)
			given = given + gm_profile.ensure_count(25045, 20)
			given = given + gm_profile.ensure_count(22030, 10)
			given = given + gm_profile.ensure_count(71054, 1)
			-- 7. Elixirs: two of each. Switching them on is the timer's job
			-- below: the engine admits one elixir use a second per player
			-- (AutoPotionUse), and the affects saved for the character arrive
			-- from the db core a moment after login.
			while pc.count_item(72726) < 2 do
				if gm_profile.give_elixir(72726) == 0 then break end
				given = given + 1
			end
			while pc.count_item(72730) < 2 do
				if gm_profile.give_elixir(72730) == 0 then break end
				given = given + 1
			end
			-- 8. The starter's leftovers, only once the profile weapon is worn:
			-- the +0 weapon of the class and the small red potions. Nothing
			-- else is taken - a chest, a material, a medal stays.
			if pc.get_wear(4) == p.weapon then
				local junk = {10, 1000, 7000, 27001, 27004}
				for i = 1, 5 do
					local n = pc.count_item(junk[i])
					if n > 0 then
						pc.remove_item(junk[i], n)
					end
				end
			end
			-- 9. The starter quests, told the starter has been handled, so no
			-- login hands this character a +0 weapon and five potions again.
			pc.setf("give_basic_weapon", "basic_weapon", 1)
			pc.setf("starter_chest", "given", 1)
			sys_log(0, "GM_PROFILE: " .. name .. " job=" .. pc.get_job() .. " level=" .. pc.get_level() .. " given=" .. given)
		end

		-- The item id of a switched-off, not yet used elixir of this vnum in
		-- the bag, or 0: the two bag pages walked with select_cell, which
		-- selects the item standing in an inventory cell.
		function find_off_elixir(vnum)
			for cell = 0, 89 do
				if item.select_cell(cell) then
					if item.get_vnum() == vnum and item.get_socket(0) == 0 and item.get_socket(1) < item.get_socket(2) then
						return item.get_id()
					end
				end
			end
			return 0
		end

		-- One elixir of this vnum switched on through its own use path, which
		-- is what makes the AFFECT_AUTO_*_RECOVERY affect: 1 when the engine
		-- took it, 0 when there was nothing to switch on or it refused.
		function switch_on(vnum)
			local id = gm_profile.find_off_elixir(vnum)
			if id == 0 then
				return 0
			end
			if not item.select(id) then
				return 0
			end
			if item.use() then
				return 1
			end
			return 0
		end

		when login with pc.get_account() == "admin" and pc.is_gm() begin
			if pc.getqf("version") < 1 then
				pc.setqf("wear_retry", 0)
				gm_profile.apply()
				pc.setqf("version", 1)
				if pc.getqf("wear_retry") == 1 then
					pc.setqf("wear_tries", 0)
					timer("gm_profile_wear", 3)
				end
			end
			-- The elixirs are switched on a few seconds after login, one per
			-- tick, and only once per character: a repeat would toggle a
			-- running one off, or hand the affect to the spare.
			if pc.getqf("elixirs_on") == 0 then
				timer("gm_profile_elixir", 3)
			end
		end

		when gm_profile_wear.timer begin
			local tries = pc.getqf("wear_tries") + 1
			pc.setqf("wear_tries", tries)
			local left = gm_profile.wear_again()
			sys_log(0, "GM_PROFILE: " .. pc.get_name() .. " wear pass " .. tries .. " unresolved=" .. left)
			if left == 1 and tries < 5 then
				timer("gm_profile_wear", 1)
			end
		end

		when gm_profile_elixir.timer begin
			if pc.getqf("elixirs_on") ~= 0 then
				return
			end
			local tries = pc.getqf("elixir_tries") + 1
			pc.setqf("elixir_tries", tries)
			if pc.getqf("hp_on") == 0 then
				local on = gm_profile.switch_on(72726)
				sys_log(0, "GM_PROFILE: " .. pc.get_name() .. " hp elixir on=" .. on .. " try=" .. tries)
				if on == 1 or tries >= 3 then
					pc.setqf("hp_on", 1)
				end
				timer("gm_profile_elixir", 2)
				return
			end
			local on = gm_profile.switch_on(72730)
			sys_log(0, "GM_PROFILE: " .. pc.get_name() .. " sp elixir on=" .. on .. " try=" .. tries)
			if on == 1 or tries >= 6 then
				pc.setqf("elixirs_on", 1)
				return
			end
			timer("gm_profile_elixir", 2)
		end
	end
end
