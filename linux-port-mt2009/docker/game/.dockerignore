# Build context for the mt2009 game image. Keep out what the build never reads.

# Derived artefacts: the image rebuilds everything from source.
**/*.o
**/*.a
**/.obj/
**/OBJDIR/
**/tags

# FreeBSD prebuilt archives from the package -- ELF (FreeBSD), cannot link here.
src/extern/lib/

# Windows project files.
**/*.vcxproj
**/*.vcxproj.filters
**/*.sln

# The runtime tree's binaries (FreeBSD) -- the image's come from the builder.
src/serverfiles/share/bin/
src/serverfiles/db/db
src/serverfiles/chs/**/game
