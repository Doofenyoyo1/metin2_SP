#!/bin/sh
# =============================================================================
#  m2-regen -- the monsters every map keeps alive (map/<map>/regen.txt), as
#  the Seban panel's "Spawny potworów na mapach" page saved them
#  (MT2009_PLUS_DB_EDITOR_V1, dbeditor/regen.py).
#
#  regen.txt lives in the image and every core reads it once, while it boots
#  (SECTREE_MANAGER::Build -> regen_load). A server update ships a new image
#  and with it new files, so an edit made in the image would be lost on the
#  next update. The panel therefore writes the whole file of every map it
#  changed into the spool volume both containers share:
#      $SPOOL/regen/custom/<map folder>.txt
#  and before the cores boot (m2-supervise, boot_cores) `apply' puts each one
#  live in place of the image's file (kept as regen.image.txt next to it),
#  after the checks below; a map without a custom file gets the image's file
#  back. How it went: $SPOOL/regen/status/<map folder>.status (state, time,
#  rows, sha of the custom file used, message).
#  The panel reads the image's files back read-only from $SPOOL/regen/base/
#  (index, group.txt, group_group.txt, maps/<map>/regen.txt + Setting.txt).
#
#  What is checked (regen.cpp read_line, the way the core reads the file):
#    * every line one entry: type x y sx sy z dir time percent count vnum
#      (or the 6 words of an "e" no-spawn area); "//" starts a comment;
#    * the type m, g, r or s, optionally followed by a, h or d - an unknown
#      type letter makes the core exit(1);
#    * whole numbers, a time like 60s / 5m / 1h30m / 5m-7m above 0 (0 means
#      the line never spawns), a count of 1-1000;
#    * the centre inside the map (MapSize x CellScale x 128 / 100 metres
#      from the map's Setting.txt);
#    * every monster (m, s) in mob_proto, every group (g) in group.txt, every
#      group of groups (r) in group_group.txt.
#  A file that fails any of that is not used at all: the map boots with the
#  image's regen.txt and the panel is told why.
#
#  Subcommands
#      prepare   as root, at container start: keep the image's files, make
#                the live ones writable by the service account, the spool
#      apply     put the panel's files live (run by m2-supervise before a boot)
# =============================================================================
set -u
LC_ALL=C
export LC_ALL

SHARE_DIR="${M2_SHARE_DIR:-/opt/metin2/share}"
VAR_DIR="${M2_VAR_DIR:-/opt/metin2/var}"
LOCALE_DIR="$SHARE_DIR/locale/${M2_LOCALE_NAME:-poland}"
MAP_DIR="$LOCALE_DIR/map"
SPOOL="${M2_RATES_SPOOL:-/opt/m2spool}/regen"
WORK="$VAR_DIR/regen"
MAX_COUNT=1000

say() { printf '%s [regen] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%SZ')" "$1"; }

write_status() { # write_status FILE STATE ROWS SHA MESSAGE
    _file=$1; shift
    _tmp="$_file.new.$$"
    { printf 'state=%s\n' "$1"
      printf 'time=%s\n' "$(date +%s 2>/dev/null)"
      printf 'rows=%s\n' "$2"
      printf 'sha=%s\n' "$3"
      printf 'message=%s\n' "$4"
    } > "$_tmp" 2>/dev/null || { rm -f "$_tmp"; return 1; }
    chmod 0664 "$_tmp" 2>/dev/null
    mv -f "$_tmp" "$_file" 2>/dev/null || rm -f "$_tmp"
    return 0
}

spool_folder() { # spool_folder DIR -- a folder both containers can use
    mkdir -p "$1" 2>/dev/null || return 1
    chgrp m2spool "$1" 2>/dev/null
    chmod 2770 "$1" 2>/dev/null
    return 0
}

# publish SOURCE PATH -- a read-only copy of an image file for the panel,
# at $SPOOL/base/PATH.
publish() {
    [ -f "$1" ] || return 0
    _dst="$SPOOL/base/$2"
    cmp -s "$1" "$_dst" && return 0
    spool_folder "$(dirname "$_dst")" || return 0
    cp "$1" "$_dst.new.$$" 2>/dev/null && chmod 0664 "$_dst.new.$$" 2>/dev/null \
        && mv -f "$_dst.new.$$" "$_dst" 2>/dev/null || rm -f "$_dst.new.$$"
}

# The live file is rewritten in place: the map folder belongs to root, the
# file itself to the service account (prepare).
put_file() { # put_file SOURCE TARGET
    cmp -s "$1" "$2" && return 0
    cat "$1" > "$2"
}

# vnums_missing KIND LIST -- the numbers of the comma-separated LIST that the
# game does not know; KIND mob (mob_proto, through the database: returns 2
# when it did not answer), group (group.txt) or group_group (group_group.txt).
vnums_missing() {
    [ -n "$2" ] || return 0
    printf '%s\n' "$2" | tr ',' '\n' | sort -u > "$WORK/vnums.wanted"
    case "$1" in
        mob)
            command -v mariadb >/dev/null 2>&1 || return 2
            MYSQL_PWD="${M2_DB_PASSWORD:-}" mariadb -h "${M2_DB_HOST:-mariadb}" -P "${M2_DB_PORT:-3306}" \
                -u "${M2_DB_USER:-metin2}" -N -B --connect-timeout=10 \
                -e "SELECT vnum FROM player.mob_proto${M2_TABLE_POSTFIX:-} WHERE vnum IN ($2)" \
                > "$WORK/vnums.found" 2>/dev/null || return 2
            ;;
        *)
            # CTextFileLoader: a "Vnum <n>" line inside every Group { }.
            tr -d '\r' < "$LOCALE_DIR/$1.txt" 2>/dev/null \
                | awk 'tolower($1) == "vnum" && $2 ~ /^[0-9]+$/ { print $2 + 0 }' > "$WORK/vnums.found"
            ;;
    esac
    sort -u "$WORK/vnums.found" | comm -23 "$WORK/vnums.wanted" - | tr '\n' ' '
    return 0
}

# map_size FOLDER -- "width height" in the regen file's metres, or nothing.
map_size() {
    tr -d '\r' < "$MAP_DIR/$1/Setting.txt" 2>/dev/null | awk '
        tolower($1) == "mapsize" { w = $2; h = $3 }
        tolower($1) == "cellscale" { c = $2 }
        END { if (w + 0 > 0 && c + 0 > 0) print int(w * c * 128 / 100), int(h * c * 128 / 100) }'
}

# apply_map FOLDER -- the panel's file of one map, or the image's.
apply_map() {
    _map=$1
    _img="$MAP_DIR/$_map/regen.image.txt"; _live="$MAP_DIR/$_map/regen.txt"
    _cus="$SPOOL/custom/$_map.txt"; _st="$SPOOL/status/$_map.status"
    if [ ! -f "$_cus" ]; then
        put_file "$_img" "$_live" || { say "could not write $_live"; return 1; }
        # Only maps the panel ever touched have a status file.
        if [ -f "$_st" ] && ! grep -q '^state=base$' "$_st" 2>/dev/null; then
            write_status "$_st" base 0 "" "no change in the panel -- the image's regen.txt is live"
            say "$_map: back to the image's regen.txt"
        fi
        return 0
    fi
    _sha=$(sha256sum "$_cus" | cut -d' ' -f1)
    _size=$(map_size "$_map")
    sed '1s/^\xEF\xBB\xBF//; s/\r$//' "$_cus" | awk -v size="$_size" -v maxcount="$MAX_COUNT" '
    function err(m) { print "E line " NR ": " m; bad = 1; exit }
    function isint(s) { return s ~ /^[0-9]+$/ }
    # read_line: digits, then h / m / s multiply what came before; "-" starts
    # the upper end of a range.
    function seconds(s,   i, c, t, tmp, end, toend) {
        t = 0; tmp = 0; end = 0; toend = 0
        for (i = 1; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (c == "-") { t += tmp; tmp = 0; toend = 1 }
            else if (c == "h" || c == "m" || c == "s") {
                tmp *= (c == "h") ? 3600 : (c == "m") ? 60 : 1
                if (toend) end += tmp; else t += tmp
                tmp = 0
            } else tmp = tmp * 10 + c
        }
        if (toend) end += tmp; else t += tmp
        return t
    }
    BEGIN { split(size, wh, " "); W = wh[1] + 0; H = wh[2] + 0 }
    {
        line = $0
        if (index(line, "\"")) err("a quote (the core reads quoted words differently)")
        n = split(line, f, /[ \t]+/)
        if (n > 0 && f[1] == "") { for (i = 2; i <= n; i++) f[i - 1] = f[i]; n-- }
        if (n > 0 && f[n] == "") n--
        for (i = 1; i <= n; i++) if (substr(f[i], 1, 2) == "//") { n = i - 1; break }
        if (n == 0) next
        t = f[1]
        if (t == "e") {
            if (n != 6) err("a no-spawn area (e) has 6 words, this line " n)
            for (i = 2; i <= 6; i++) if (!isint(f[i])) err("\"" f[i] "\" is not a whole number")
            next
        }
        if (t !~ /^[mgrs][ahd]?$/) err("unknown type \"" t "\" (m, g, r, s, optionally + a/h/d; the core exits on others)")
        if (n != 11) err("a spawn line has 11 words, this one " n)
        for (i = 2; i <= 7; i++) if (!isint(f[i])) err("\"" f[i] "\" is not a whole number")
        if (f[8] !~ /^[0-9][0-9hms]*(-[0-9][0-9hms]*)?$/) err("bad time \"" f[8] "\" (e.g. 60s, 5m, 5m-7m)")
        if (seconds(f[8]) < 1) err("time 0 - the line would never spawn")
        if (!isint(f[9])) err("bad percent \"" f[9] "\"")
        if (!isint(f[10]) || f[10] + 0 < 1 || f[10] + 0 > maxcount) err("count must be 1-" maxcount)
        if (!isint(f[11]) || f[11] + 0 < 1) err("bad monster/group number \"" f[11] "\"")
        if (W > 0 && (f[2] + 0 > W || f[3] + 0 > H)) err("(" f[2] ", " f[3] ") lies outside the map (" W " x " H ")")
        k = substr(t, 1, 1)
        print (k == "g" ? "G " : k == "r" ? "R " : "M ") (f[11] + 0)
        rows++
    }
    END { if (!bad) print "N " rows + 0 }
    ' > "$WORK/check" 2>&1
    _why=$(sed -n 's/^E //p' "$WORK/check" | head -1)
    _rows=$(sed -n 's/^N //p' "$WORK/check" | head -1)
    if [ -z "$_why" ] && [ -z "$_rows" ]; then
        _why="the check did not run ($(head -c 200 "$WORK/check" | tr '\n' ' '))"
    fi
    if [ -z "$_why" ]; then
        for _kind in group group_group mob; do
            case "$_kind" in group) _tag=G ;; group_group) _tag=R ;; *) _tag=M ;; esac
            _list=$(sed -n "s/^$_tag //p" "$WORK/check" | sort -un | tr '\n' ',' | sed 's/,$//')
            _missing=$(vnums_missing "$_kind" "$_list"); _rc=$?
            if [ "$_rc" = "2" ]; then
                say "$_map: could not check the monsters against the database -- trusting the panel's check"
                continue
            fi
            if [ -n "$(printf '%s' "$_missing" | tr -d ' ')" ]; then
                case "$_kind" in
                    mob) _why="no such monster (mob_proto): $_missing" ;;
                    group) _why="no such group (group.txt): $_missing" ;;
                    *) _why="no such group of groups (group_group.txt): $_missing" ;;
                esac
                break
            fi
        done
    fi
    if [ -n "$_why" ]; then
        say "$_map: the panel's regen.txt was NOT used: $_why"
        put_file "$_img" "$_live"
        write_status "$_st" rejected 0 "$_sha" "$_why"
        return 0
    fi
    if ! put_file "$_cus" "$_live"; then
        say "$_map: could not write $_live -- left as it was"
        write_status "$_st" failed 0 "$_sha" "the game container could not write regen.txt"
        return 1
    fi
    say "$_map: regen.txt from the panel applied ($_rows lines)"
    write_status "$_st" ok "$_rows" "$_sha" "applied: the panel's regen.txt ($_rows lines)"
    return 0
}

cmd_prepare() {
    [ -d "$MAP_DIR" ] || { say "no $MAP_DIR -- nothing to prepare"; return 0; }
    # The first start of a container: the files are still the image's (a new
    # image means a new container, so an update always brings its own).
    for _d in "$MAP_DIR"/*/; do
        [ -f "${_d}regen.txt" ] || continue
        [ -f "${_d}regen.image.txt" ] || cp -p "${_d}regen.txt" "${_d}regen.image.txt" || return 1
        chown metin2:metin2 "${_d}regen.txt" 2>/dev/null
        chmod 0644 "${_d}regen.txt" 2>/dev/null
    done
    mkdir -p "$WORK" 2>/dev/null && chown metin2:metin2 "$WORK" 2>/dev/null
    for _d in "$SPOOL" "$SPOOL/custom" "$SPOOL/status" "$SPOOL/backup" "$SPOOL/base" "$SPOOL/base/maps"; do
        spool_folder "$_d"
    done
    chgrp -R m2spool "$SPOOL" 2>/dev/null
    return 0
}

cmd_apply() {
    [ -d "$MAP_DIR" ] || { say "no $MAP_DIR -- nothing to do"; return 0; }
    mkdir -p "$WORK" 2>/dev/null
    for _d in "$SPOOL" "$SPOOL/status" "$SPOOL/base" "$SPOOL/base/maps"; do
        spool_folder "$_d" || { say "no spool folder $_d -- the image's spawns stay"; return 0; }
    done
    publish "$MAP_DIR/index" index
    publish "$LOCALE_DIR/group.txt" group.txt
    publish "$LOCALE_DIR/group_group.txt" group_group.txt
    _maps=0; _custom=0
    for _d in "$MAP_DIR"/*/; do
        _map=$(basename "$_d")
        [ -f "${_d}regen.image.txt" ] || continue
        _maps=$((_maps + 1))
        publish "${_d}regen.image.txt" "maps/$_map/regen.txt"
        publish "${_d}Setting.txt" "maps/$_map/Setting.txt"
        [ -f "$SPOOL/custom/$_map.txt" ] && _custom=$((_custom + 1))
        apply_map "$_map" || say "$_map: the panel's regen.txt could not be applied"
    done
    # A custom file of a map this image does not have.
    for _c in "$SPOOL/custom/"*.txt; do
        [ -f "$_c" ] || continue
        _map=$(basename "$_c" .txt)
        [ -f "$MAP_DIR/$_map/regen.image.txt" ] && continue
        write_status "$SPOOL/status/$_map.status" rejected 0 "$(sha256sum "$_c" | cut -d' ' -f1)" \
            "this game image has no map $_map"
        say "$_map: no such map in this image -- the panel's file was not used"
    done
    say "$_maps map(s) published, $_custom changed in the panel"
    return 0
}

case "${1:-}" in
    prepare) cmd_prepare ;;
    apply)   cmd_apply ;;
    *) echo "usage: m2-regen prepare|apply"; exit 1 ;;
esac
